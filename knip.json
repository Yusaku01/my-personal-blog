{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["textlint.config.blog-base.cjs", "textlint.config.blog-tech.cjs"],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn"
  },
  "ignoreDependencies": [
    "@astrojs/check",
    "@fontsource/zen-kaku-gothic-new",
    "@playwright/browser-chromium",
    "@unocss/preset-icons",
    "@unocss/preset-typography",
    "@unocss/reset",
    "@typescript-eslint/.*",
    "@eslint/.*",
    "astro-eslint-parser",
    "eslint-.*",
    "textlint.*",
    "cloudflare"
  ]
}
