---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import Breadcrumb from '../components/Breadcrump/Breadcrumb.astro';
import {
  getLanguageSwitchHref,
  getLocaleFromPathname,
  localeMeta,
  siteDescription,
  type Locale,
} from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  blogTitle?: string; // ブログ記事のタイトルを渡すためのプロパティを追加
  blogContentLocale?: Locale;
  robots?: string;
  locale?: Locale;
}

const {
  title,
  description,
  blogTitle, // ブログタイトルを受け取る
  blogContentLocale,
  robots = 'index, follow',
  locale: localeProp,
} = Astro.props;

// OGP画像パスを動的に設定
let ogImageUrl;

// URLパス名を取得
const pathname = Astro.url.pathname;
const locale = localeProp ?? getLocaleFromPathname(pathname);
const localizedDescription = description ?? siteDescription[locale];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const alternateJaUrl = new URL(getLanguageSwitchHref(pathname, 'ja'), Astro.site).toString();
const alternateEnUrl = new URL(getLanguageSwitchHref(pathname, 'en'), Astro.site).toString();
const ogpPathname =
  pathname === '/en' || pathname === '/en/'
    ? '/'
    : pathname.startsWith('/en/')
      ? pathname.slice(3)
      : pathname;

if (blogTitle) {
  // ブログ記事の場合、スラッグに基づいたOGP画像を使用
  const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || 'index';
  ogImageUrl =
    blogContentLocale === 'en' ? `/images/ogp/en/${slug}.png` : `/images/ogp/${slug}.png`;
} else if (ogpPathname === '/' || ogpPathname === '') {
  // トップページ
  ogImageUrl = '/images/ogp/default.png';
} else if (ogpPathname === '/blog' || ogpPathname === '/blog/') {
  // ブログ一覧ページ
  ogImageUrl = '/images/ogp/blog.png';
} else if (ogpPathname === '/blog/personal' || ogpPathname === '/blog/personal/') {
  ogImageUrl = '/images/ogp/blog-personal.png';
} else if (ogpPathname === '/blog/zenn' || ogpPathname === '/blog/zenn/') {
  ogImageUrl = '/images/ogp/blog-zenn.png';
} else if (ogpPathname === '/blog/qiita' || ogpPathname === '/blog/qiita/') {
  ogImageUrl = '/images/ogp/blog-qiita.png';
} else if (ogpPathname === '/finds' || ogpPathname === '/finds/') {
  // ファインズページ
  ogImageUrl = '/images/ogp/finds.png';
} else if (ogpPathname === '/profile' || ogpPathname === '/profile/') {
  // プロフィールページ
  ogImageUrl = '/images/ogp/profile.png';
} else if (ogpPathname === '/contact' || ogpPathname === '/contact/') {
  // お問い合わせページ
  ogImageUrl = '/images/ogp/contact.png';
} else {
  // その他のページ
  ogImageUrl = '/images/ogp/default.png';
}

// Google Analytics IDを環境変数から取得
const gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta content="email=no,telephone=no,address=no" name="format-detection" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ja" href={alternateJaUrl} />
    <link rel="alternate" hreflang="en" href={alternateEnUrl} />
    <link rel="alternate" hreflang="x-default" href={alternateJaUrl} />
    <link rel="dns-prefetch" href="https://images.weserv.nl" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="preconnect" href="https://images.weserv.nl" crossorigin="anonymous" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://www.google.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin="anonymous" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={localizedDescription} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
    <!-- テーマ切り替え -->
    <script is:inline data-astro-rerun>
      // Wrap in an IIFE to avoid leaking identifiers across reruns/navigation.
      (() => {
        const STORAGE_KEY = 'theme';

        const resolveTheme = () => {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored === 'dark' || stored === 'light') {
            return stored;
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        const applyTheme = (theme = resolveTheme()) => {
          document.documentElement.classList.toggle('dark', theme === 'dark');
          localStorage.setItem(STORAGE_KEY, theme);
          window.dispatchEvent(new Event('themechange'));
        };

        if (!window.__astroThemeSync) {
          document.addEventListener('astro:before-swap', (event) => {
            const theme = resolveTheme();
            event.newDocument.documentElement.classList.toggle('dark', theme === 'dark');
          });

          document.addEventListener('astro:after-swap', () => {
            applyTheme();
          });

          window.__astroThemeSync = true;
        }

        applyTheme();
      })();
    </script>
    <!-- OGP 基本設定 -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={localizedDescription} />
    <meta property="og:type" content={blogTitle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImageUrl, Astro.site).toString()} />
    <meta property="og:site_name" content="SAKUSPACE" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={localizedDescription} />
    <meta name="twitter:image" content={new URL(ogImageUrl, Astro.site).toString()} />
    <meta name="twitter:site" content="@sakuspace" />

    <Font cssVariable="--font-zen-kaku-gothic-new" preload={[{ weight: 700 }]} />

    <!-- Google Analytics (gtag.js): only when ID is provided -->
    <script is:inline define:vars={{ gaId }}>
      if (gaId) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        window.dataLayer = window.dataLayer || [];
        s.addEventListener('load', function () {
          if (typeof window.gtag === 'function') {
            window.gtag('js', new Date());
            window.gtag('config', gaId);
          }
        });
        document.head.appendChild(s);
      }
    </script>

    <!-- Google reCAPTCHA is injected per-page where needed -->

    <slot name="head" />
  </head>

  <body
    class="min-h-screen flex flex-col text-gray-800 dark:text-gray-100 transition-colors overscroll-none"
  >
    <Header locale={locale} />
    <main class="flex-grow bg-gray-100 dark:bg-gray-800">
      <slot />
    </main>
    <Breadcrumb blogTitle={blogTitle} locale={locale} />
    <Footer locale={locale} />
    <style is:global>
      :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          rgb(var(--accent-light)) 30%,
          white 60%
        );
        --font-body:
          var(--font-zen-kaku-gothic-new), system-ui, -apple-system, 'Hiragino Kaku Gothic ProN',
          'Yu Gothic', Meiryo, sans-serif;
        --fs-body: clamp(1rem, calc(0.98rem + 0.12vw), 1.0625rem);
        --fs-h1: clamp(1.875rem, calc(1.72rem + 0.78vw), 2.25rem);
        --fs-h2: clamp(1.5rem, calc(1.26rem + 1.17vw), 2.25rem);
        --fs-h3: clamp(1.25rem, calc(1.1rem + 0.73vw), 1.875rem);
        --fs-h4: clamp(1.125rem, calc(1.04rem + 0.42vw), 1.5rem);
        --fs-h5: clamp(1rem, calc(0.95rem + 0.24vw), 1.25rem);
        --fs-h6: clamp(1rem, calc(0.99rem + 0.05vw), 1.125rem);
        --cards-min: clamp(15rem, 27vw, 16rem);
        --cards-gap: clamp(0.875rem, 1.2vw, 1.5rem);
        --cards-min-compact: clamp(18rem, 40vw, 20rem);
        --cards-gap-compact: clamp(0.75rem, 1vw, 1.25rem);
      }

      body {
        font-family: var(--font-body);
        font-size: var(--fs-body);
        font-synthesis-weight: none;
      }

      img {
        content-visibility: auto;
      }

      .grid-fluid-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--cards-min)), 1fr));
        gap: var(--cards-gap);
      }

      .grid-fluid-cards-blog {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--cards-min)), 1fr));
        justify-content: start;
      }

      .grid-fluid-cards-compact {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--cards-min-compact)), 1fr));
        gap: var(--cards-gap-compact);
      }

      .prose .rlc-container {
        background-color: rgb(255 255 255);
        border: 1px solid rgb(229 231 235);
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        display: flex;
        gap: 0;
        margin-block: 1.5rem;
        overflow: hidden;
        text-decoration: none;
        transition-duration: 200ms;
        transition-property: box-shadow;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        width: 100%;
      }

      html.dark .prose .rlc-container {
        background-color: rgb(31 41 55);
        border-color: rgb(55 65 81);
      }

      .prose .rlc-container:hover {
        color: rgb(17 24 39);
      }

      html.dark .prose .rlc-container:hover {
        color: rgb(243 244 246);
      }

      .prose .rlc-info {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        min-width: 0;
        padding: 1.5rem;
      }

      .prose .rlc-title {
        color: rgb(17 24 39);
        display: -webkit-box;
        font-size: 1rem;
        font-weight: 600;
        line-clamp: 2;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      html.dark .prose .rlc-title {
        color: rgb(243 244 246);
      }

      .prose .rlc-description {
        color: rgb(75 85 99);
        display: -webkit-box;
        font-size: 0.875rem;
        line-clamp: 2;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      html.dark .prose .rlc-description {
        color: rgb(209 213 219);
      }

      .prose .rlc-url-container {
        align-items: center;
        color: rgb(107 114 128);
        display: flex;
        font-size: 0.75rem;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      html.dark .prose .rlc-url-container {
        color: rgb(156 163 175);
      }

      .prose .rlc-favicon {
        height: 1rem;
        margin-block: 0;
        width: 1rem;
      }

      .prose .rlc-url {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .prose .rlc-image-container {
        display: none;
      }

      .prose .rlc-image {
        border-radius: 0;
        height: 100%;
        object-fit: cover;
        width: 100%;
      }
    </style>
  </body>
</html>
