---
// Removed invalid Fragment usage; use slot on element directly
import Layout from '../../layouts/Layout.astro';
import BlogControls from '../../components/Blog/BlogControls.astro';
import HeroSection from '../../components/Hero/HeroSection.astro';
import { getAllBlogPosts } from '../../lib/blog/posts';
import { getImage } from 'astro:assets';

export const transition = { name: 'fade' };

const sortedPosts = await getAllBlogPosts();
const primaryThumbnail = sortedPosts.find((post) => Boolean(post.thumbnail))?.thumbnail;
const primaryThumbnailImage = primaryThumbnail
  ? await getImage({
      src: primaryThumbnail,
      width: 600,
      height: 315,
      fit: 'cover',
    })
  : null;
---

<Layout
  title="BLOG | SAKUSPACE"
  description="個人ブログ、Zenn（Scrap含む）、Qiitaの投稿をまとめた記事一覧。最新順で掲載しています。"
>
  {
    primaryThumbnailImage && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={primaryThumbnailImage.src}
        fetchpriority="high"
        crossorigin="anonymous"
      />
    )
  }
  <HeroSection title="BLOG" />
  <div class="container-lg container-lg py-14">
    <BlogControls
      posts={sortedPosts}
      currentPath={Astro.url.pathname}
      currentQuery={Astro.url.searchParams.get('q') ?? ''}
    />
  </div>
</Layout>
