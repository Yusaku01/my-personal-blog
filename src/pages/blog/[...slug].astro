---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/Blog/TableOfContents.astro';
import ShareButtons from '../../components/Sns/ShareButtons.astro';
import { format } from 'date-fns';

export const transition = { name: 'fade' };

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<Layout title={`${post.data.title} | SAKUSPACE`} blogTitle={post.data.title}>
  <div class="bg-gray-50 dark:bg-gray-800 py-25">
    <div class="container-md container-base">
      <article>
        <!-- 1. Title -->
        <h1 class="heading-h1 lg:text-4xl mb-6">{post.data.title}</h1>

        <!-- 2. Thumbnail Image -->
        {
          post.data.image && (
            <div class="mb-6">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="aspect-[16/9] object-cover rounded-lg"
              />
            </div>
          )
        }

        <!-- 3. Tags -->
        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="mb-5">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="border border-gray-900 dark:border-gray-200 text-gray-700 dark:text-gray-200 px-3 py-1 rounded-full text-sm font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        <!-- 4. Publish Date and Author -->
        <div class="flex items-center gap-4 text-gray-600 dark:text-gray-400 mb-8 text-sm">
          <span>{format(post.data.publishDate, 'yyyy年MM月dd日')}</span>
          {post.data.author && <span>{post.data.author}</span>}
        </div>

        <!-- 5. Table of Contents -->
        <TableOfContents headings={headings} />

        <!-- 6. Content -->
        <div
          class="blog-article-content prose prose-lg max-w-none prose-headings:font-bold prose-a:text-sky-600 prose-a:underline-offset-4 hover:prose-a:underline dark:prose-invert dark:prose-a:text-sky-300 dark:hover:prose-a:text-sky-200 prose-img:rounded-lg mt-8"
          data-blog-content
        >
          <Content />
        </div>

        <div
          id="blog-image-modal"
          class="blog-image-modal fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4"
          aria-hidden="true"
        >
          <button
            type="button"
            class="absolute top-6 right-6 text-white text-3xl leading-none"
            data-modal-close
            aria-label="画像モーダルを閉じる"
          >
            ×
          </button>
          <img
            id="blog-image-modal-img"
            class="max-h-[90vh] max-w-[90vw] rounded-lg shadow-2xl"
            alt=""
          />
        </div>

        <!-- SNS Share Buttons -->
        <div class="mt-16 pt-8">
          <ShareButtons
            url={new URL(Astro.url.pathname, Astro.site).toString()}
            title={post.data.title}
            class="justify-center md:justify-start"
          />
        </div>
      </article>
    </div>
  </div>
</Layout>

<style is:global>
  .footnotes {
    @apply border-t border-gray-200 dark:border-gray-700 mt-12 pt-8;
  }
  .footnotes ol {
    @apply mb-0;
  }
  .footnotes li:last-child p {
    @apply mb-0;
  }

  .prose .rlc-container {
    @apply bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-200 dark:border-gray-700 transition-all duration-200 lg:hover:shadow-md no-underline flex items-stretch gap-0 w-full my-6;
  }

  .prose a {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .prose .rlc-container:hover {
    @apply text-gray-900 dark:text-gray-100;
  }

  .prose .rlc-info {
    @apply p-6 flex flex-col gap-1.5 min-w-0;
  }

  .prose .rlc-title {
    @apply text-md font-semibold text-gray-900 dark:text-gray-100 line-clamp-2;
  }

  .prose .rlc-description {
    @apply text-sm text-gray-600 dark:text-gray-300 line-clamp-2;
  }

  .prose .rlc-url-container {
    @apply mt-4 flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400;
  }

  .prose .rlc-favicon {
    @apply w-4 h-4;
    margin-block: 0;
  }

  .prose .rlc-url {
    @apply truncate;
  }

  .prose .rlc-image-container {
    @apply hidden;
  }

  .prose .rlc-image {
    @apply w-full h-full object-cover rounded-none;
  }

  .blog-article-content img {
    cursor: zoom-in;
    -webkit-touch-callout: none;
  }

  .blog-image-modal {
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      visibility 0ms linear 200ms;
    visibility: hidden;
  }

  .blog-image-modal.is-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 200ms ease,
      visibility 0ms;
  }

  .blog-image-modal img {
    transform: scale(0.98);
    opacity: 0;
    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }

  .blog-image-modal.is-open img {
    transform: scale(1);
    opacity: 1;
  }

  /* 必要であればフットノート内のリンクスタイルも調整 */
  /* .footnotes a {
    @apply text-brand hover:underline;
  } */
</style>

<script>
  import { bindImageZoom } from '@/scripts/image-zoom';

  bindImageZoom();
</script>
