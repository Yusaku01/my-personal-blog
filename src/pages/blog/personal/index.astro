---
import Layout from '../../../layouts/Layout.astro';
import BlogControls from '../../../components/Blog/BlogControls.astro';
import HeroSection from '../../../components/Hero/HeroSection.astro';
import { getAllBlogPosts } from '../../../lib/blog/posts';
import { getImage } from 'astro:assets';

export const transition = { name: 'fade' };

const allPosts = await getAllBlogPosts();
const filteredPosts = allPosts.filter((post) => post.source === 'personal');
const primaryThumbnail = filteredPosts.find((post) => Boolean(post.thumbnail))?.thumbnail;
const primaryThumbnailImage = primaryThumbnail
  ? await getImage({
      src: primaryThumbnail,
      width: 600,
      height: 315,
      fit: 'cover',
    })
  : null;
---

<Layout
  title="BLOG（個人ブログ）| SAKUSPACE"
  description="SAKUSPACEの個人ブログ記事一覧。最新順で個人ブログのみを掲載しています。"
>
  {
    primaryThumbnailImage && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={primaryThumbnailImage.src}
        fetchpriority="high"
        crossorigin="anonymous"
      />
    )
  }
  <HeroSection title="BLOG" isHome={false} />
  <div class="container-lg container-lg py-14">
    <BlogControls posts={filteredPosts} currentPath={Astro.url.pathname} />
  </div>
</Layout>
