---
import { getImage } from 'astro:assets';
import Layout from '../../../../layouts/Layout.astro';
import BlogControls from '../../../../components/Blog/BlogControls.astro';
import HeroSection from '../../../../components/Hero/HeroSection.astro';
import { getAllBlogPosts } from '../../../../lib/blog/posts';

export const transition = { name: 'fade' };

const locale = 'en';
const allPosts = await getAllBlogPosts(locale);
const filteredPosts = allPosts.filter((post) => post.source === 'personal');
const primaryThumbnail = filteredPosts.find((post) => Boolean(post.thumbnail))?.thumbnail;
const primaryThumbnailImage = primaryThumbnail
  ? await getImage({
      src: primaryThumbnail,
      width: 600,
      height: 315,
      fit: 'cover',
    })
  : null;
---

<Layout
  title="Personal Blog | SAKUSPACE"
  description="Personal SAKUSPACE blog posts in chronological order. English translations are planned, and Japanese posts are shown for now."
  locale={locale}
>
  {
    primaryThumbnailImage && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={primaryThumbnailImage.src}
        fetchpriority="high"
        crossorigin="anonymous"
      />
    )
  }
  <HeroSection title="BLOG" />
  <div class="container-lg container-lg py-14">
    <BlogControls
      posts={filteredPosts}
      currentPath={Astro.url.pathname}
      currentQuery={Astro.url.searchParams.get('q') ?? ''}
      locale={locale}
    />
  </div>
</Layout>
