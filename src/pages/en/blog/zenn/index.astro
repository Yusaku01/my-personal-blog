---
import { getImage } from 'astro:assets';
import Layout from '../../../../layouts/Layout.astro';
import BlogControls from '../../../../components/Blog/BlogControls.astro';
import HeroSection from '../../../../components/Hero/HeroSection.astro';
import { getAllBlogPosts } from '../../../../lib/blog/posts';

export const transition = { name: 'fade' };

const locale = 'en';
const allPosts = await getAllBlogPosts(locale);
const filteredPosts = allPosts.filter(
  (post) => post.source === 'zenn' || post.source === 'zennScrap'
);
const primaryThumbnail = filteredPosts.find((post) => Boolean(post.thumbnail))?.thumbnail;
const primaryThumbnailHref =
  typeof primaryThumbnail === 'string'
    ? primaryThumbnail
    : primaryThumbnail
      ? (
          await getImage({
            src: primaryThumbnail,
            width: 600,
            height: 320,
            fit: 'cover',
          })
        ).src
      : null;
---

<Layout
  title="Zenn Posts | SAKUSPACE"
  description="Zenn posts and scraps by SAKUSPACE in chronological order."
  locale={locale}
>
  {
    primaryThumbnailHref && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={primaryThumbnailHref}
        fetchpriority="high"
        crossorigin="anonymous"
      />
    )
  }
  <HeroSection title="BLOG" />
  <div class="container-lg container-lg py-14">
    <BlogControls
      posts={filteredPosts}
      currentPath={Astro.url.pathname}
      currentQuery={Astro.url.searchParams.get('q') ?? ''}
      locale={locale}
    />
  </div>
</Layout>
