---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/Hero/HeroSection.astro';
import SectionHeading from '../../components/Section/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { uiText } from '../../lib/i18n';

export const transition = { name: 'fade' };

const locale = 'en';
const feedEntries = await getCollection('findsFeed');
const feeds = feedEntries.flatMap((entry) => entry.data.feeds).filter((feed) => feed.enabled);
---

<Layout
  title="Finds | SAKUSPACE"
  description="RSS feeds and articles followed and recommended by SAKUSPACE."
  locale={locale}
>
  <HeroSection title="FINDS" />

  <div class="finds-page">
    <div class="finds-container">
      <section class="finds-intro-section">
        <SectionHeading title="What is FINDS" />
        <div class="finds-intro">
          <p>
            {uiText.finds.description[locale]}<br />
            {uiText.finds.recommendation[locale]}
          </p>
          <p class="finds-copyright">
            {uiText.finds.copyright[locale]}
          </p>
        </div>
      </section>

      <section class="finds-feeds-section">
        <SectionHeading title="Feeds I Follow" />
        <div class="finds-feeds grid-fluid-cards-compact">
          {
            feeds.map((feed) => (
              <div class="finds-feed">
                <div class="finds-feed-header">
                  <h3 class="finds-feed-name">
                    {feed.nameUrl ? (
                      <a
                        href={feed.nameUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="finds-feed-link"
                      >
                        {feed.name}
                      </a>
                    ) : (
                      feed.name
                    )}
                  </h3>
                  {feed.tags.length > 0 && (
                    <div class="finds-feed-tags">
                      {feed.tags.map((tag) => (
                        <span class="finds-feed-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
                {feed.description && <p class="finds-feed-description">{feed.description}</p>}
                <a
                  href={feed.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="finds-feed-subscribe"
                >
                  {uiText.finds.subscribe[locale]}
                  <span class="ui-icon ui-icon--external finds-feed-external" aria-hidden="true" />
                </a>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .finds-page {
    padding-block: 2.5rem;
  }
  .finds-container {
    margin-inline: auto;
    max-width: 56rem;
    padding-inline: 1rem;
  }
  .finds-intro-section {
    margin-bottom: 3rem;
  }
  .finds-intro {
    color: rgb(55 65 81);
    line-height: 1.625;
    margin-top: 1.5rem;
  }
  .finds-intro > :global(:not([hidden]) ~ :not([hidden])) {
    margin-top: 1rem;
    margin-bottom: 0;
  }
  .finds-copyright {
    color: rgb(75 85 99);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .finds-copyright > :global(:not([hidden]) ~ :not([hidden])) {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }
  .finds-feeds-section {
    margin-bottom: 1.5rem;
  }
  .finds-feeds {
    margin-top: 1.5rem;
  }
  .finds-feed {
    background-color: rgb(255 255 255);
    border: 1px solid var(--color-section-border);
    border-radius: 0.375rem;
    padding: 1rem;
  }
  .finds-feed-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }
  .finds-feed-name {
    color: var(--color-heading);
    font-weight: 600;
  }
  .finds-feed-link,
  .finds-feed-subscribe {
    text-underline-offset: 4px;
  }
  .finds-feed-link:hover,
  .finds-feed-subscribe:hover {
    text-decoration-line: underline;
  }
  .finds-feed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .finds-feed-tag {
    align-items: center;
    border: 1px solid rgb(17 24 39);
    border-radius: 9999px;
    color: rgb(55 65 81);
    display: inline-flex;
    font-size: 0.625rem;
    font-weight: 500;
    padding: 0.125rem 0.5rem;
  }
  .finds-feed-description {
    color: rgb(75 85 99);
    font-size: 0.875rem;
    line-height: 1.25rem;
    margin-top: 0.5rem;
  }
  .finds-feed-subscribe {
    align-items: center;
    color: rgb(55 65 81);
    display: inline-flex;
    font-size: 0.875rem;
    line-height: 1.25rem;
    margin-top: 0.75rem;
  }
  .finds-feed-external {
    font-size: 0.875rem;
    margin-left: 0.25rem;
  }
  :global(html.dark) .finds-intro,
  :global(html.dark) .finds-feed-subscribe {
    color: rgb(209 213 219);
  }
  :global(html.dark) .finds-copyright,
  :global(html.dark) .finds-feed-description {
    color: rgb(156 163 175);
  }
  :global(html.dark) .finds-feed {
    background-color: rgb(17 24 39);
  }
  :global(html.dark) .finds-feed-tag {
    border-color: rgb(75 85 99);
    color: rgb(229 231 235);
  }
</style>
