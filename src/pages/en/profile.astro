---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/Hero/HeroSection.astro';
import ProfileAvatar from '../../components/Profile/ProfileAvatar.astro';
import ProfileSection from '../../components/Profile/ProfileSection.astro';
import { uiText } from '../../lib/i18n';

export const transition = { name: 'fade' };

const locale = 'en';
---

<Layout
  title="Profile | SAKUSPACE"
  description="Profile of Sakku, the frontend engineer and designer behind SAKUSPACE."
  locale={locale}
>
  <HeroSection title="PROFILE" />

  <div class="py-8">
    <div class="container-md">
      <div class="rounded-md overflow-hidden">
        <div class="px-2 py-8">
          <div class="flex flex-col md:flex-row items-center gap-6 mb-8">
            <ProfileAvatar
              locale={locale}
              imageId="profile-page-avatar"
              size={160}
              className="w-40"
              loading="eager"
              fetchpriority="high"
            />
            <div class="text-center md:text-left">
              <p class="text-xl font-bold lg:text-2xl text-gray-900 dark:text-white">
                {uiText.profile.name[locale]}
              </p>
              <p class="text-md text-gray-600 dark:text-gray-300 mt-1">
                {uiText.profile.role[locale]}
              </p>
            </div>
          </div>

          <ProfileSection title={uiText.profile.aboutTitle[locale]} className="mb-10">
            <div class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
              {uiText.profile.aboutBody.en.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </ProfileSection>
        </div>
      </div>
    </div>
  </div>
</Layout>
