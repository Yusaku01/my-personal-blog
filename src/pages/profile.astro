---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import ProfileSection from '../components/Profile/ProfileSection.astro';
import { getEntry, render } from 'astro:content';
import { uiText } from '../lib/i18n';

export const transition = { name: 'fade' };

import { Image } from 'astro:assets';
import profileAvatarImage from '../assets/images/img_profile-avatar.webp';

const locale = 'ja';
const profileEntry = await getEntry('profile', 'main');

if (!profileEntry) {
  throw new Error('Profile entry not found: src/content/profile/main.mdx');
}

const profile = profileEntry.data;
const { Content } = await render(profileEntry);
---

<Layout
  title="プロフィール | SAKUSPACE"
  description="SAKUSPACEを運営するサックのプロフィール、自己紹介、関心領域を掲載しています。"
  locale={locale}
>
  <HeroSection title="PROFILE" />

  <div class="py-8">
    <div class="container-md">
      <div class="rounded-md overflow-hidden">
        <div class="px-2 py-8">
          <!-- プロフィールヘッダー -->
          <div class="flex flex-col md:flex-row items-center gap-6 mb-8">
            <!-- プロフィール画像 -->
            <div
              class="w-40 h-40 rounded-full overflow-hidden relative z-10 bg-white dark:bg-gray-700"
            >
              <Image
                src={profileAvatarImage}
                alt={uiText.profile.imageAlt[locale]}
                class="w-full h-full object-cover"
                width={160}
                height={160}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
            <!-- 名前と肩書き -->
            <div class="text-center md:text-left">
              <p class="text-xl font-bold lg:text-2xl text-gray-900 dark:text-white">
                {profile.name}
              </p>
              <p class="text-md text-gray-600 dark:text-gray-300 mt-1">{profile.role}</p>
            </div>
          </div>

          <!-- 自己紹介セクション -->
          <ProfileSection title={uiText.profile.aboutTitle[locale]} className="mb-10">
            <div class="text-gray-700 dark:text-gray-300 leading-relaxed">
              <Content />
            </div>
          </ProfileSection>
        </div>
      </div>
    </div>
  </div>
</Layout>
