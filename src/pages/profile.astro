---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import ProfileAvatar from '../components/Profile/ProfileAvatar.astro';
import ProfileSection from '../components/Profile/ProfileSection.astro';
import ProfileTimeline from '../components/Profile/ProfileTimeline.astro';
import { getEntry, render } from 'astro:content';
import { uiText } from '../lib/i18n';

export const transition = { name: 'fade' };

const locale = 'ja';
const profileEntry = await getEntry('profile', 'main');

if (!profileEntry) {
  throw new Error('Profile entry not found: src/content/profile/main.mdx');
}

const profile = profileEntry.data;
const timeline = profile.timeline ?? [];
const { Content } = await render(profileEntry);
---

<Layout
  title="プロフィール | SAKUSPACE"
  description="SAKUSPACEを運営するサックのプロフィール、自己紹介、関心領域を掲載しています。"
  locale={locale}
>
  <HeroSection title="PROFILE" />

  <div class="profile-page">
    <div class="profile-container">
      <div class="profile-card">
        <div class="profile-card-content">
          <!-- プロフィールヘッダー -->
          <div class="profile-header">
            <ProfileAvatar
              locale={locale}
              imageId="profile-page-avatar"
              size={160}
              className="profile-page-avatar"
              loading="eager"
              fetchpriority="high"
            />
            <!-- 名前と肩書き -->
            <div class="profile-identity">
              <p class="profile-name">
                {profile.name}
              </p>
              <p class="profile-role">{profile.role}</p>
            </div>
          </div>

          <!-- 自己紹介セクション -->
          <ProfileSection title={uiText.profile.aboutTitle[locale]}>
            <div class="profile-about">
              <Content />
            </div>
          </ProfileSection>

          {
            timeline.length > 0 && (
              <ProfileSection title={uiText.profile.timelineTitle[locale]}>
                <ProfileTimeline entries={timeline} locale={locale} />
              </ProfileSection>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .profile-page {
    padding-block: 2rem;
  }
  .profile-container {
    margin-inline: auto;
    max-width: 56rem;
    padding-inline: 1rem;
  }
  .profile-card {
    border-radius: 0.375rem;
    overflow: hidden;
  }
  .profile-card-content {
    padding: 2rem 0.5rem;
  }
  .profile-header {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .profile-header :global(.profile-page-avatar) {
    width: 10rem;
  }
  .profile-identity {
    text-align: center;
  }
  .profile-name {
    color: var(--color-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.75rem;
  }
  .profile-role {
    color: rgb(75 85 99);
    margin-top: 0.25rem;
  }
  .profile-about {
    color: rgb(55 65 81);
    line-height: 1.625;
  }
  :global(html.dark) .profile-role,
  :global(html.dark) .profile-about {
    color: rgb(209 213 219);
  }
  @media (min-width: 768px) {
    .profile-header {
      flex-direction: row;
    }
    .profile-identity {
      text-align: left;
    }
  }
  @media (min-width: 1024px) {
    .profile-name {
      font-size: 1.5rem;
      line-height: 2rem;
    }
  }
</style>
