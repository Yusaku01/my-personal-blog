---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import PostCard from '../components/Blog/PostCard.astro';
import SectionHeading from '../components/Section/SectionHeading.astro';
import { getAllBlogPosts } from '../lib/blog/posts';
import { localizedPath, uiText } from '../lib/i18n';

export const transition = { name: 'fade' };

const locale = 'ja';
const allPosts = await getAllBlogPosts(locale);

const POSTS_PER_SECTION = 4;

import { Image } from 'astro:assets';
import profileAvatarImage from '../assets/images/img_profile-avatar.webp';
---

<Layout title="SAKUSPACE" locale={locale}>
  <HeroSection title="SAKUSPACE" />
  <div class="py-16">
    <div class="container-lg container-base">
      <section class="mb-16">
        <SectionHeading title="BLOG" className="heading-h2 tracking-widest" />
        <div class="grid-fluid-cards">
          {
            allPosts
              .slice(0, POSTS_PER_SECTION)
              .map((post) => (
                <PostCard
                  title={post.title}
                  url={post.url}
                  publishDate={post.publishDate}
                  excerpt={post.excerpt}
                  platform={post.platform}
                  isExternal={post.isExternal}
                  thumbnail={post.thumbnail}
                  tags={post.tags || []}
                  showTags={false}
                  locale={locale}
                />
              ))
          }
        </div>
        <div class="text-center mt-8">
          <a href={localizedPath('/blog', locale)} class="btn-primary inline-block">
            {uiText.blog.viewAll[locale]}
          </a>
        </div>
      </section>

      <section class="mb-16">
        <SectionHeading title="PROFILE" className="heading-h2 tracking-widest" />
        <div class="py-6">
          <div class="flex flex-col md:flex-row gap-4 md:gap-8 items-center">
            <div class="w-32 h-32 rounded-full overflow-hidden flex-shrink-0">
              <Image
                src={profileAvatarImage}
                alt={uiText.profile.imageAlt[locale]}
                class="w-full h-full object-cover"
                width={128}
                height={128}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex-grow">
              <h3 class="heading-h3 text-center md:text-left mb-2">
                {uiText.profile.name[locale]}
              </h3>
              <p class="text-gray-700 dark:text-gray-300 mb-6 mb:mb-4 text-center md:text-left">
                {uiText.profile.role[locale]}
              </p>
              <p class="text-gray-600 dark:text-gray-400">
                {uiText.profile.intro[locale]}<br />{uiText.profile.note[locale]}
              </p>
            </div>
          </div>
          <div class="mt-6 text-center">
            <a href={localizedPath('/profile', locale)} class="btn-primary inline-block">
              {uiText.profile.more[locale]}
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
