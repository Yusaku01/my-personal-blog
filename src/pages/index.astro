---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import PostCard from '../components/Blog/PostCard.astro';
import ProfileAvatar from '../components/Profile/ProfileAvatar.astro';
import SectionHeading from '../components/Section/SectionHeading.astro';
import { getAllBlogPosts } from '../lib/blog/posts';
import { localizedPath, uiText } from '../lib/i18n';

export const transition = { name: 'fade' };

const locale = 'ja';
const allPosts = await getAllBlogPosts(locale);

const POSTS_PER_SECTION = 4;
---

<Layout title="SAKUSPACE" locale={locale}>
  <HeroSection title="SAKUSPACE" />
  <div class="home-page">
    <div class="home-container">
      <section class="home-section">
        <SectionHeading title="BLOG" />
        <div class="grid-fluid-cards">
          {
            allPosts
              .slice(0, POSTS_PER_SECTION)
              .map((post) => (
                <PostCard
                  title={post.title}
                  url={post.url}
                  publishDate={post.publishDate}
                  excerpt={post.excerpt}
                  platform={post.platform}
                  isExternal={post.isExternal}
                  thumbnail={post.thumbnail}
                  tags={post.tags || []}
                  showTags={false}
                  locale={locale}
                />
              ))
          }
        </div>
        <div class="home-blog-action">
          <a href={localizedPath('/blog', locale)} class="primary-link">
            {uiText.blog.viewAll[locale]}
          </a>
        </div>
      </section>

      <section class="home-section">
        <SectionHeading title="PROFILE" />
        <div class="home-profile">
          <div class="home-profile-summary">
            <ProfileAvatar
              locale={locale}
              imageId="home-profile-avatar"
              size={128}
              className="home-profile-avatar"
            />
            <div class="home-profile-copy">
              <h3 class="home-profile-name">
                {uiText.profile.name[locale]}
              </h3>
              <p class="home-profile-role">
                {uiText.profile.role[locale]}
              </p>
              <p class="home-profile-intro">
                {uiText.profile.intro[locale]}
              </p>
            </div>
          </div>
          <div class="home-profile-action">
            <a href={localizedPath('/profile', locale)} class="primary-link">
              {uiText.profile.more[locale]}
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .home-page {
    padding-block: 4rem;
  }
  .home-container {
    margin-inline: auto;
    max-width: 1132px;
    padding-inline: 1rem;
  }
  .home-section {
    margin-bottom: 4rem;
  }
  .home-blog-action {
    margin-top: 2rem;
    text-align: center;
  }
  .home-profile {
    padding-block: 1.5rem;
  }
  .home-profile-summary {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .home-profile-summary :global(.home-profile-avatar) {
    flex-shrink: 0;
    width: 8rem;
  }
  .home-profile-copy {
    flex-grow: 1;
  }
  .home-profile-name {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .home-profile-role {
    color: rgb(55 65 81);
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .home-profile-intro {
    color: rgb(75 85 99);
  }
  .home-profile-action {
    margin-top: 1.5rem;
    text-align: center;
  }
  :global(html.dark) .home-profile-role {
    color: rgb(209 213 219);
  }
  :global(html.dark) .home-profile-intro {
    color: rgb(156 163 175);
  }
  @media (min-width: 768px) {
    .home-profile-summary {
      flex-direction: row;
      gap: 2rem;
    }
    .home-profile-name,
    .home-profile-role {
      text-align: left;
    }
  }
</style>
