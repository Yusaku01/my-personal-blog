const fieldErrors = failedSubmission?.fieldErrors ?? {};
const formError = failedSubmission?.message ?? null;

const fieldIds = {
  name: 'contact-name',
  email: 'contact-email',
  subject: 'contact-subject',
  message: 'contact-message',
} as const;
