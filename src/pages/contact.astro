  return Astro.redirect('/contact?sent=1');
}

const defaultValues: ContactForm = {
  name: '',
  email: '',
  subject: '',
  message: '',
};

const failedSubmission = actionResult?.data && !actionResult.data.ok ? actionResult.data : null;
