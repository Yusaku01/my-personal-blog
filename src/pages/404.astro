---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Hero/HeroSection.astro';

export const transition = { name: 'fade' };

Astro.response.status = 404;
Astro.response.statusText = 'Not found';
---

<Layout
  title="404 | SAKUSPACE"
  description="お探しのページは見つかりませんでした。URLをご確認いただくか、ブログ一覧から目的のページをお探しください。"
  robots="noindex, nofollow"
>
  <HeroSection title="404" />

  <section class="not-found-page">
    <div class="not-found-container">
      <div class="not-found-panel">
        <div class="not-found-grid">
          <div class="not-found-content">
            <p class="not-found-kicker">PAGE NOT FOUND</p>
            <h2 class="not-found-title">お探しのページは見つかりませんでした</h2>
            <p class="not-found-description">
              URL
              が変更されたか、記事やページが削除された可能性があります。トップページやブログ一覧から辿り直していただくと見つかる場合があります。
            </p>

            <div class="not-found-actions">
              <a href="/" class="primary-link not-found-primary">ホームへ戻る</a>
              <a href="/blog" class="not-found-secondary"> ブログを見る </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found-page {
    padding-block: 2.5rem;
  }
  .not-found-container {
    margin-inline: auto;
    max-width: 56rem;
    padding-inline: 1rem;
  }
  .not-found-panel {
    background-color: rgb(255 255 255);
    border: 1px solid var(--color-section-border);
    border-radius: 1.5rem;
    padding: 1.5rem;
  }
  .not-found-grid {
    display: grid;
  }
  .not-found-content {
    text-align: center;
  }
  .not-found-kicker {
    color: rgb(107 114 128);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    line-height: 1.25rem;
  }
  .not-found-title {
    color: var(--color-heading);
    font-size: var(--fs-h2);
    margin-top: 0.75rem;
  }
  .not-found-description {
    color: rgb(55 65 81);
    line-height: 1.625;
    margin-top: 1rem;
    text-align: left;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .not-found-primary,
  .not-found-secondary {
    min-width: 154px;
  }
  .not-found-secondary {
    align-items: center;
    border: 1px solid rgb(209 213 219);
    border-radius: 0.375rem;
    color: rgb(31 41 55);
    display: inline-flex;
    font-weight: 700;
    justify-content: center;
    padding: 0.5rem 1rem;
    transition-property:
      color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-duration: 300ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  .not-found-secondary:hover {
    background-color: rgb(243 244 246);
  }
  :global(html.dark) .not-found-panel {
    background-color: rgb(17 24 39);
  }
  :global(html.dark) .not-found-kicker {
    color: rgb(156 163 175);
  }
  :global(html.dark) .not-found-description {
    color: rgb(209 213 219);
  }
  :global(html.dark) .not-found-secondary {
    border-color: rgb(75 85 99);
    color: rgb(243 244 246);
  }
  :global(html.dark) .not-found-secondary:hover {
    background-color: rgb(31 41 55);
  }
  @media (min-width: 640px) {
    .not-found-page {
      padding-block: 3.5rem;
    }
    .not-found-panel {
      padding: 2rem;
    }
    .not-found-description {
      text-align: center;
    }
  }
</style>
