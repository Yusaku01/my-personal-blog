---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/Hero/HeroSection.astro';

export const transition = { name: 'fade' };

Astro.response.status = 404;
Astro.response.statusText = 'Not found';
---

<Layout
  title="404 | SAKUSPACE"
  description="お探しのページは見つかりませんでした。URLをご確認いただくか、ブログ一覧から目的のページをお探しください。"
  robots="noindex, nofollow"
>
  <HeroSection title="404" />

  <section class="py-10 sm:py-14">
    <div class="container-md container-base">
      <div
        class="rounded-3xl border border-gray-200 bg-white p-6 sm:p-8 dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="grid">
          <div class="text-center">
            <p class="text-sm font-bold tracking-[0.28em] text-gray-500 dark:text-gray-400">
              PAGE NOT FOUND
            </p>
            <h2 class="heading-h2 mt-3 text-gray-900 dark:text-white">
              お探しのページは見つかりませんでした
            </h2>
            <p
              class="mt-4 text-left leading-relaxed text-gray-700 dark:text-gray-300 sm:text-center"
            >
              URL
              が変更されたか、記事やページが削除された可能性があります。トップページやブログ一覧から辿り直していただくと見つかる場合があります。
            </p>

            <div class="mt-6 flex flex-wrap justify-center gap-3">
              <a href="/" class="btn-primary inline-block min-w-[154px]">ホームへ戻る</a>
              <a
                href="/blog"
                class="inline-flex min-w-[154px] items-center justify-center rounded-md border border-gray-300 px-4 py-2 font-bold text-gray-800 transition-colors duration-300 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-100 dark:hover:bg-gray-800"
              >
                ブログを見る
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
