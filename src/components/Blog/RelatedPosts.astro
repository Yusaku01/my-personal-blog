---
import { format } from 'date-fns';
import type { Post } from '../../types/index';
import { uiText, type Locale } from '../../lib/i18n';

interface RelatedPostsProps {
  posts: Post[];
  locale?: Locale;
}

const { posts, locale = 'ja' } = Astro.props as RelatedPostsProps;
---

{
  posts.length > 0 && (
    <section class="mt-16 border-t border-gray-200 pt-8 dark:border-gray-700">
      <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">
        {uiText.blog.relatedPosts[locale]}
      </h2>
      <ul class="grid gap-3 md:grid-cols-2">
        {posts.map((post) => {
          const publishDate = new Date(post.publishDate);
          const excerpt = post.excerpt?.trim();

          return (
            <li>
              <a
                href={post.url}
                class="group flex h-full min-h-32 flex-col justify-between rounded-md border border-gray-200 bg-white p-4 transition-colors hover:border-gray-400 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:hover:border-gray-500 dark:hover:bg-gray-800 dark:focus-visible:outline-white"
              >
                <span>
                  <span class="block text-base font-bold leading-snug text-gray-900 transition-colors group-hover:text-gray-700 dark:text-white dark:group-hover:text-gray-200">
                    {post.title}
                  </span>
                  {excerpt && (
                    <span class="mt-2 line-clamp-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                      {excerpt}
                    </span>
                  )}
                </span>
                <span class="mt-3 inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                  <time datetime={publishDate.toISOString()}>
                    {format(publishDate, 'yyyy/MM/dd')}
                  </time>
                  <span
                    class="i-ic-round-arrow-forward inline-block text-4 transition-transform duration-200 group-hover:translate-x-2 group-focus-visible:translate-x-2"
                    aria-hidden="true"
                  />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
