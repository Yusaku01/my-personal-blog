---
import type { Post } from '../../types/index';
import { Image } from 'astro:assets';
import { formatPublishDate } from '../../lib/blog/formatPublishDate';
import { uiText, type Locale } from '../../lib/i18n';

type PostCardProps = Post & {
  showTags?: boolean;
  index?: number;
  locale?: Locale;
};

const {
  title,
  url,
  publishDate,
  thumbnail,
  isExternal,
  tags = [],
  showTags = true,
  index,
  platform,
  locale = 'ja',
} = Astro.props as PostCardProps;

// 最初の8枚はlazyしない・1枚目のみfetchpriorityをhighに
const shouldLazyLoad = index !== undefined && index >= 8;
const fetchPriority = index === 0 ? 'high' : undefined;

const publishDateObj = new Date(publishDate);
---

<article
  class="post-card"
  data-post-card
  data-title={title.toLowerCase()}
  data-tags={tags.map((tag) => tag.toLowerCase()).join(' ')}
>
  <a
    href={url}
    class="post-card__link"
    target={isExternal ? '_blank' : '_self'}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >
    {
      thumbnail && (
        <div class="post-card__image-frame">
          {isExternal && typeof thumbnail === 'string' ? (
            <img
              src={thumbnail}
              alt={title}
              width="600"
              height="315"
              class="post-card__image"
              loading={shouldLazyLoad ? 'lazy' : 'eager'}
              fetchpriority={fetchPriority}
              decoding="async"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
            />
          ) : !isExternal && typeof thumbnail !== 'string' ? (
            <Image
              src={thumbnail}
              alt={title}
              width={600}
              height={315}
              fit="cover"
              class="post-card__image"
              loading={shouldLazyLoad ? 'lazy' : 'eager'}
              fetchpriority={fetchPriority}
              decoding="async"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
              position="center"
            />
          ) : null}
          <div class="post-card__overlay">
            <span class="post-card__read-label">{uiText.blog.readArticle[locale]}</span>
          </div>
        </div>
      )
    }
    <div class="post-card__content">
      <h2 class="post-card__title">{title}</h2>
      <div class="post-card__details">
        <time datetime={publishDateObj.toISOString()} class="post-card__date">
          {formatPublishDate(publishDateObj)}
          {isExternal && platform && ` ${platform} ${uiText.blog.externalPostSuffix[locale]}`}
          {
            isExternal && (
              <span
                class="ui-icon ui-icon--external post-card__external-icon"
                aria-label={uiText.blog.externalLinkLabel[locale]}
              />
            )
          }
        </time>
        {
          showTags && tags.length > 0 && (
            <div class="post-card__tags">
              {tags.map((tag) => (
                <span class="post-card__tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    height: 100%;
    overflow: hidden;
    border-radius: 0.375rem;
    background-color: rgb(255 255 255);
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(html.dark) .post-card {
    background-color: rgb(17 24 39);
  }

  .post-card__link {
    display: block;
  }

  .post-card__image-frame {
    position: relative;
    aspect-ratio: 40 / 21;
    overflow: hidden;
    border-bottom: 1px solid rgb(209 213 219);
    border-color: rgb(209 213 219);
  }

  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 300ms ease-in-out;
  }

  .post-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 0);
    transition: all 300ms ease-in-out;
  }

  .post-card__read-label {
    color: rgb(255 255 255);
    font-weight: 700;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translate3d(0, 1rem, 0);
    transition: all 300ms ease-in-out;
  }

  .post-card__content {
    padding: 1rem;
  }

  .post-card__title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-heading);
    font-weight: 600;
    line-height: 1.25;
    word-break: break-all;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .post-card__details > :not([hidden]) ~ :not([hidden]) {
    margin-top: 0.5rem;
  }

  .post-card__date {
    color: rgb(75 85 99);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  :global(html.dark) .post-card__date {
    color: rgb(156 163 175);
  }

  .post-card__external-icon {
    margin-left: 0.25rem;
    font-size: 0.875rem;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-card__tag {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgb(17 24 39);
    border-radius: 9999px;
    padding: 0.125rem 0.625rem;
    color: rgb(55 65 81);
    font-size: 0.625rem;
    font-weight: 500;
  }

  :global(html.dark) .post-card__tag {
    border-color: rgb(75 85 99);
    color: rgb(229 231 235);
  }

  @media (min-width: 1024px) {
    .post-card__link:hover .post-card__overlay {
      background-color: rgb(0 0 0 / 0.6);
    }

    .post-card__link:hover .post-card__read-label {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
</style>
