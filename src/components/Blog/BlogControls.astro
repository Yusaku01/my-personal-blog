---
import type { SearchablePost } from '../../types/index';
import PostCard from './PostCard.astro';
import { buildBlogTabHref, getInitialBlogSearchState } from '../../lib/blog/search';
import { localizedPath, uiText, type Locale } from '../../lib/i18n';

interface BlogControlsProps {
  posts: SearchablePost[];
  currentPath: string;
  currentQuery?: string;
  locale?: Locale;
}

const { posts, currentPath, currentQuery = '', locale = 'ja' } = Astro.props as BlogControlsProps;
const initialPostCount = 12;
const hasMorePosts = posts.length > initialPostCount;
const initialSearchState = getInitialBlogSearchState(posts, currentQuery, initialPostCount);

const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const activePath = normalizePath(currentPath);

const tabs = [
  { label: uiText.blog.tabs.all[locale], href: localizedPath('/blog/', locale) },
  { label: uiText.blog.tabs.personal[locale], href: localizedPath('/blog/personal/', locale) },
  { label: uiText.blog.tabs.zenn[locale], href: localizedPath('/blog/zenn/', locale) },
  { label: uiText.blog.tabs.qiita[locale], href: localizedPath('/blog/qiita/', locale) },
];

const searchIndexUrl = localizedPath('/search-index.json', locale);
---

<div
  class="blog-controls"
  data-blog-search-root
  data-initial-post-count={String(initialPostCount)}
  data-initial-query={initialSearchState.activeQuery}
  data-search-index-url={searchIndexUrl}
>
  <form class="blog-controls__form" data-blog-search-form>
    <label class="blog-controls__label">
      <span class="blog-controls__label-text">{uiText.blog.searchLabel[locale]}</span>
      <input
        type="search"
        id="blog-search-input"
        data-blog-search-input
        placeholder={uiText.blog.searchLabel[locale]}
        autocomplete="off"
        value={initialSearchState.activeQuery}
        class="blog-controls__input"
      />
    </label>
    <button type="submit" class="blog-controls__submit">
      {uiText.blog.searchButton[locale]}
    </button>
    <div
      data-blog-search-history
      hidden
      class="blog-controls__history"
      aria-label={uiText.blog.searchHistory[locale]}
    >
    </div>
  </form>
  <p data-blog-search-error hidden class="blog-controls__error" role="status">
    {uiText.blog.searchError[locale]}
  </p>

  <div class="blog-controls__tabs">
    {
      tabs.map((tab) => {
        const isActive = activePath === normalizePath(tab.href);
        return (
          <a
            href={buildBlogTabHref(tab.href, currentQuery)}
            data-blog-tab
            data-blog-base-href={tab.href}
            class="blog-controls__tab"
            aria-current={isActive ? 'page' : undefined}
          >
            {tab.label}
          </a>
        );
      })
    }
  </div>

  <div class="blog-controls__rss">
    <a href="/rss.xml" class="blog-controls__rss-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="currentColor"
        viewBox="0 0 16 16"
      >
        <path
          d="M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm-3-8.5a1 1 0 0 1 1-1c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1-1-1zm0 4a1 1 0 0 1 1-1 6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1-1-1z"
        ></path>
      </svg>
      {uiText.blog.rss[locale]}
    </a>
  </div>

  <div data-blog-empty class="blog-controls__empty" hidden={initialSearchState.matchedCount > 0}>
    <p class="blog-controls__empty-message">
      {uiText.blog.empty[locale]}
    </p>
  </div>

  <div class="grid-fluid-cards grid-fluid-cards-blog" id="blog-post-grid">
    {
      posts.map((post, index) => (
        <div
          data-post-wrapper
          data-index={index}
          data-post-url={post.url}
          hidden={initialSearchState.hiddenStates[index]}
        >
          <PostCard {...post} index={index} locale={locale} />
        </div>
      ))
    }
  </div>

  {
    hasMorePosts && (
      <div
        class="blog-controls__more"
        hidden={!initialSearchState.shouldShowLoadMore}
        data-blog-load-more-container
      >
        <button data-blog-load-more class="blog-controls__load-more" type="button">
          {uiText.blog.loadMore[locale]}
        </button>
      </div>
    )
  }
</div>

<style>
  .blog-controls__form {
    position: relative;
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .blog-controls__label {
    display: block;
    width: 100%;
  }

  .blog-controls__label-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    border-width: 0;
    padding: 0;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .blog-controls__input {
    width: 100%;
    border: 1px solid rgb(229 231 235);
    border-radius: 0.375rem;
    background-color: rgb(255 255 255);
    padding: 0.5rem;
  }

  :global(html.dark) .blog-controls__input {
    border-style: none;
    color: rgb(34 34 34);
  }

  .blog-controls__input:focus {
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow: 0 0 0 2px rgb(51 51 51);
  }

  .blog-controls__submit {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    height: 100%;
    border-top-right-radius: 0.375rem;
    border-bottom-right-radius: 0.375rem;
    background-color: rgb(51 51 51);
    padding: 0.5rem 1rem;
    color: rgb(255 255 255);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 2;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(html.dark) .blog-controls__submit {
    border-style: none;
  }

  .blog-controls__history {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 10;
    overflow: hidden;
    margin-top: 0.5rem;
    border: 1px solid var(--color-section-border);
    border-radius: 0.375rem;
    background-color: rgb(255 255 255);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  :global(html.dark) .blog-controls__history {
    background-color: rgb(17 24 39);
  }

  .blog-controls :global(.blog-controls__history-item) {
    width: 100%;
    padding: 0.5rem 0.75rem;
    color: rgb(55 65 81);
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-align: center;
    transition:
      color 150ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-controls :global(.blog-controls__history-item:hover) {
    background-color: rgb(243 244 246);
  }

  :global(html.dark) .blog-controls :global(.blog-controls__history-item) {
    color: rgb(229 231 235);
  }

  :global(html.dark) .blog-controls :global(.blog-controls__history-item:hover) {
    background-color: rgb(31 41 55);
  }

  .blog-controls__error {
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 1rem;
    color: rgb(220 38 38);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  :global(html.dark) .blog-controls__error {
    color: rgb(248 113 113);
  }

  .blog-controls__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .blog-controls__tab {
    min-width: 4rem;
    border: 1px solid rgb(229 231 235);
    border-radius: 9999px;
    background-color: rgb(255 255 255);
    padding: 0.375rem 0.5rem;
    color: rgb(55 65 81);
    text-align: center;
    transition:
      color 150ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 150ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-controls__tab[aria-current='page'] {
    border-color: rgb(51 51 51);
    background-color: rgb(51 51 51);
    color: rgb(255 255 255);
    font-weight: 700;
  }

  .blog-controls__tab:not([aria-current='page']):hover {
    background-color: rgb(243 244 246);
  }

  :global(html.dark) .blog-controls__tab:not([aria-current='page']) {
    border-color: rgb(55 65 81);
    background-color: rgb(17 24 39);
    color: rgb(229 231 235);
  }

  :global(html.dark) .blog-controls__tab:not([aria-current='page']):hover {
    background-color: rgb(31 41 55);
  }

  .blog-controls__rss {
    margin-bottom: 2rem;
    text-align: center;
  }

  .blog-controls__rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgb(75 85 99);
    font-size: 0.875rem;
    line-height: 1.25rem;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(html.dark) .blog-controls__rss-link {
    color: rgb(156 163 175);
  }

  .blog-controls__rss-link:hover {
    color: rgb(17 24 39);
  }

  :global(html.dark) .blog-controls__rss-link:hover {
    color: rgb(229 231 235);
  }

  .blog-controls__empty {
    padding-block: 3rem;
    text-align: center;
  }

  .blog-controls__empty-message {
    color: rgb(75 85 99);
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  :global(html.dark) .blog-controls__empty-message {
    color: rgb(156 163 175);
  }

  .blog-controls__more {
    margin-top: 3rem;
    text-align: center;
  }

  .blog-controls__load-more {
    border-radius: 0.375rem;
    background-color: rgb(51 51 51);
    padding: 0.5rem 1.5rem;
    color: rgb(255 255 255);
    font-weight: 700;
    line-height: 2;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(html.dark) .blog-controls__load-more {
    background-color: rgb(255 255 255);
    color: rgb(51 51 51);
  }

  @media (min-width: 1024px) {
    .blog-controls__submit:hover,
    .blog-controls__load-more:hover {
      opacity: 0.7;
    }
  }
</style>

<script>
  import { installBlogSearch } from '../../lib/blog/searchController';

  installBlogSearch();
</script>
