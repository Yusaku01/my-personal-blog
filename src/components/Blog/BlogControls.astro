---
import type { Post } from '../../types/index';
import PostCard from './PostCard.astro';

interface BlogControlsProps {
  posts: Post[];
  currentPath: string;
}

const { posts, currentPath } = Astro.props as BlogControlsProps;
const initialPostCount = 12;
const hasMorePosts = posts.length > initialPostCount;

const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const activePath = normalizePath(currentPath);

const tabs = [
  { label: '全て', href: '/blog/' },
  { label: '個人ブログ', href: '/blog/personal/' },
  { label: 'Zenn（Scrap含む）', href: '/blog/zenn/' },
  { label: 'Qiita', href: '/blog/qiita/' },
];
---

<div>
  <form class="mb-8 max-w-xl mx-auto relative" id="blog-search-form">
    <div class="w-full">
      <input
        type="search"
        id="blog-search-input"
        placeholder="記事を検索する"
        class="w-full px-2 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-[#333] bg-white dark:bg-white dark:border-none dark:text-[#222]"
      />
    </div>
    <button
      type="submit"
      class="absolute top-0 right-0 px-4 py-2 text-sm bg-[#333] text-white lg:hover:opacity-70 transition-all duration-300 rounded-r-md h-full font-bold leading-loose dark:border-none grid align-center text-[16px]"
    >
      検索する
    </button>
  </form>

  <div class="flex flex-wrap justify-center gap-3 mb-8 text-sm">
    {
      tabs.map((tab) => {
        const isActive = activePath === normalizePath(tab.href);
        return (
          <a
            href={tab.href}
            class={`px-4 py-2 rounded-full border transition-colors ${
              isActive
                ? 'bg-[#333] text-white border-[#333]'
                : 'bg-white text-gray-700 border-gray-200 hover:bg-gray-100 dark:bg-gray-900 dark:text-gray-200 dark:border-gray-700 dark:hover:bg-gray-800'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {tab.label}
          </a>
        );
      })
    }
  </div>

  <div class="text-center mb-8">
    <a
      href="/rss.xml"
      class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="currentColor"
        viewBox="0 0 16 16"
      >
        <path
          d="M3.999 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-8zM2 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V4z"
        ></path>
        <path
          d="M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm-3-8.5a1 1 0 0 1 1-1c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1-1-1zm0 4a1 1 0 0 1 1-1 6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1-1-1z"
        ></path>
      </svg>
      RSSフィードで購読
    </a>
  </div>

  <div id="blog-empty" class="text-center py-12 hidden">
    <p class="text-gray-600 dark:text-gray-400 text-lg">
      検索条件に一致する記事が見つかりませんでした。
    </p>
  </div>

  <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" id="blog-post-grid">
    {
      posts.map((post, index) => (
        <div data-post-wrapper data-index={index} class={index >= initialPostCount ? 'hidden' : ''}>
          <PostCard {...post} index={index} />
        </div>
      ))
    }
  </div>

  {
    hasMorePosts && (
      <div class="text-center mt-12" id="blog-load-more-container">
        <button
          id="blog-load-more"
          class="px-6 py-2 bg-[#333] text-white rounded-md lg:hover:opacity-70 transition-all duration-300 dark:bg-white dark:text-[#333] font-bold leading-loose"
          type="button"
        >
          過去の記事を見る
        </button>
      </div>
    )
  }
</div>

<script is:inline define:vars={{ initialPostCount }}>
  const initBlogControls = () => {
    if (window.__blogControlsAbort) {
      window.__blogControlsAbort.abort();
    }

    const controller = new AbortController();
    window.__blogControlsAbort = controller;

    const searchInput = document.querySelector('#blog-search-input');
    const postWrappers = Array.from(document.querySelectorAll('[data-post-wrapper]'));
    const emptyEl = document.querySelector('#blog-empty');
    const loadMoreBtn = document.querySelector('#blog-load-more');
    const loadMoreContainer = document.querySelector('#blog-load-more-container');

    let showAll = false;

    const applyFilter = () => {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let matched = 0;

      postWrappers.forEach((wrapper, index) => {
        const card = wrapper.querySelector('[data-post-card]');
        const title = card?.getAttribute('data-title') || '';
        const tags = card?.getAttribute('data-tags') || '';
        const isMatch = title.includes(query) || tags.includes(query);

        if (!isMatch) {
          wrapper.classList.add('hidden');
          return;
        }

        matched += 1;

        if (!query && !showAll && index >= initialPostCount) {
          wrapper.classList.add('hidden');
        } else {
          wrapper.classList.remove('hidden');
        }
      });

      if (emptyEl) {
        emptyEl.classList.toggle('hidden', matched > 0);
      }

      if (loadMoreContainer) {
        const shouldHideLoadMore =
          !!query || showAll || matched <= initialPostCount || loadMoreBtn === null;
        loadMoreContainer.classList.toggle('hidden', shouldHideLoadMore);
      }
    };

    searchInput?.addEventListener(
      'input',
      () => {
        showAll = false;
        applyFilter();
      },
      { signal: controller.signal }
    );

    document.getElementById('blog-search-form')?.addEventListener(
      'submit',
      (e) => {
        e.preventDefault();
        applyFilter();
      },
      { signal: controller.signal }
    );

    loadMoreBtn?.addEventListener(
      'click',
      () => {
        showAll = true;
        applyFilter();
      },
      { signal: controller.signal }
    );

    applyFilter();
  };

  document.addEventListener('astro:after-swap', initBlogControls);
  initBlogControls();
</script>
