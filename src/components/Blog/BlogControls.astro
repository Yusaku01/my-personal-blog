---
import type { SearchablePost } from '../../types/index';
import PostCard from './PostCard.astro';
import { buildBlogTabHref, getInitialBlogSearchState } from '../../lib/blog/search';
import { localizedPath, uiText, type Locale } from '../../lib/i18n';

interface BlogControlsProps {
  posts: SearchablePost[];
  currentPath: string;
  currentQuery?: string;
  locale?: Locale;
}

const { posts, currentPath, currentQuery = '', locale = 'ja' } = Astro.props as BlogControlsProps;
const initialPostCount = 12;
const hasMorePosts = posts.length > initialPostCount;
const initialSearchState = getInitialBlogSearchState(posts, currentQuery, initialPostCount);

const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const activePath = normalizePath(currentPath);

const tabs = [
  { label: uiText.blog.tabs.all[locale], href: localizedPath('/blog/', locale) },
  { label: uiText.blog.tabs.personal[locale], href: localizedPath('/blog/personal/', locale) },
  { label: uiText.blog.tabs.zenn[locale], href: localizedPath('/blog/zenn/', locale) },
  { label: uiText.blog.tabs.qiita[locale], href: localizedPath('/blog/qiita/', locale) },
];

const searchIndexUrl = localizedPath('/search-index.json', locale);
---

<div
  data-blog-search-root
  data-initial-post-count={String(initialPostCount)}
  data-initial-query={initialSearchState.activeQuery}
  data-search-index-url={searchIndexUrl}
>
  <form class="mb-8 max-w-xl mx-auto relative" data-blog-search-form>
    <label class="block w-full">
      <span class="sr-only">{uiText.blog.searchLabel[locale]}</span>
      <input
        type="search"
        id="blog-search-input"
        data-blog-search-input
        placeholder={uiText.blog.searchLabel[locale]}
        autocomplete="off"
        value={initialSearchState.activeQuery}
        class="w-full px-2 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-[#333] bg-white dark:bg-white dark:border-none dark:text-[#222]"
      />
    </label>
    <button
      type="submit"
      class="absolute top-0 right-0 px-4 py-2 text-sm bg-[#333] text-white lg:hover:opacity-70 transition-all duration-300 rounded-r-md h-full font-bold leading-loose dark:border-none grid align-center text-[16px]"
    >
      {uiText.blog.searchButton[locale]}
    </button>
    <div
      data-blog-search-history
      class="absolute left-0 right-0 z-10 mt-2 hidden overflow-hidden rounded-md border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-900"
      aria-label={uiText.blog.searchHistory[locale]}
    >
    </div>
  </form>
  <p
    data-blog-search-error
    class="mx-auto mb-4 hidden max-w-xl text-sm text-red-600 dark:text-red-400"
    role="status"
  >
    {uiText.blog.searchError[locale]}
  </p>

  <div class="flex flex-wrap justify-center gap-3 mb-8 text-sm">
    {
      tabs.map((tab) => {
        const isActive = activePath === normalizePath(tab.href);
        return (
          <a
            href={buildBlogTabHref(tab.href, currentQuery)}
            data-blog-tab
            data-blog-base-href={tab.href}
            class={`px-4 py-2 rounded-full border transition-colors ${
              isActive
                ? 'bg-[#333] text-white border-[#333]'
                : 'bg-white text-gray-700 border-gray-200 hover:bg-gray-100 dark:bg-gray-900 dark:text-gray-200 dark:border-gray-700 dark:hover:bg-gray-800'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {tab.label}
          </a>
        );
      })
    }
  </div>

  <div class="text-center mb-8">
    <a
      href="/rss.xml"
      class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="currentColor"
        viewBox="0 0 16 16"
      >
        <path
          d="M3.999 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-8zM2 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V4z"
        ></path>
        <path
          d="M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm-3-8.5a1 1 0 0 1 1-1c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1-1-1zm0 4a1 1 0 0 1 1-1 6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1-1-1z"
        ></path>
      </svg>
      {uiText.blog.rss[locale]}
    </a>
  </div>

  <div
    data-blog-empty
    class:list={[
      'text-center py-12',
      {
        hidden: initialSearchState.matchedCount > 0,
      },
    ]}
  >
    <p class="text-gray-600 dark:text-gray-400 text-lg">
      {uiText.blog.empty[locale]}
    </p>
  </div>

  <div class="grid-fluid-cards grid-fluid-cards-blog" id="blog-post-grid">
    {
      posts.map((post, index) => (
        <div
          data-post-wrapper
          data-index={index}
          data-post-url={post.url}
          class:list={{
            hidden: initialSearchState.hiddenStates[index],
          }}
        >
          <PostCard {...post} index={index} locale={locale} />
        </div>
      ))
    }
  </div>

  {
    hasMorePosts && (
      <div
        class:list={[
          'text-center mt-12',
          {
            hidden: !initialSearchState.shouldShowLoadMore,
          },
        ]}
        data-blog-load-more-container
      >
        <button
          data-blog-load-more
          class="px-6 py-2 bg-[#333] text-white rounded-md lg:hover:opacity-70 transition-all duration-300 dark:bg-white dark:text-[#333] font-bold leading-loose"
          type="button"
        >
          {uiText.blog.loadMore[locale]}
        </button>
      </div>
    )
  }
</div>

<script>
  import { installBlogSearch } from '../../lib/blog/searchController';

  installBlogSearch();
</script>
