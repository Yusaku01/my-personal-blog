---
import SocialIcons from '../Sns/SocialIcons.astro';
import {
  getLanguageSwitchHref,
  getLocaleFromPathname,
  localeMeta,
  navItemsForLocale,
  type Locale,
} from '../../lib/i18n';

const currentYear = new Date().getFullYear();
const { pathname } = Astro.url;
const { locale = getLocaleFromPathname(pathname) } = Astro.props as { locale?: Locale };

// ヘッダーと同じナビゲーションアイテムを定義
const navItems = navItemsForLocale(locale);
const languageItems = [
  { locale: 'ja' as const, href: getLanguageSwitchHref(pathname, 'ja', Astro.url.search) },
  { locale: 'en' as const, href: getLanguageSwitchHref(pathname, 'en', Astro.url.search) },
];

// サイトマップへのリンクを追加
const footerLinks = navItems;
---

<footer
  class="bg-gray-900 text-white dark:text-gray-400 dark:bg-gray-900 transition-colors mt-auto border-t border-gray-700"
>
  <div class="container mx-auto px-4 py-20">
    <!-- フッターナビゲーション -->
    <div class="flex flex-col md:flex-row justify-center items-center mb-8 gap-4">
      <nav aria-label={locale === 'ja' ? 'フッターナビゲーション' : 'Footer navigation'}>
        <ul class="flex flex-wrap justify-center items-center gap-x-7 gap-y-2">
          {
            footerLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white dark:text-gray-300 lg:hover:underline duration-300"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
          <li class="hidden md:block text-gray-500" aria-hidden="true">|</li>
          <li>
            <div
              class="flex items-center gap-2 font-bold tracking-wider"
              aria-label="Language switcher"
            >
              {
                languageItems.map((item, index) => (
                  <>
                    {index > 0 && <span class="text-gray-500">|</span>}
                    <a
                      href={item.href}
                      class:list={[
                        'px-1 text-white underline-offset-4 transition-colors hover:underline dark:text-gray-300',
                        {
                          'opacity-100': item.locale === locale,
                          'opacity-55': item.locale !== locale,
                        },
                      ]}
                      aria-current={item.locale === locale ? 'page' : undefined}
                      lang={localeMeta[item.locale].htmlLang}
                    >
                      {localeMeta[item.locale].label}
                    </a>
                  </>
                ))
              }
            </div>
          </li>
        </ul>
      </nav>
    </div>

    <!-- SNSアイコン -->
    <div class="flex justify-center items-center mb-8">
      <SocialIcons
        variant="minimal"
        class="gap-4 flex-wrap"
        networks={['GitHub', 'X', 'LinkedIn', 'Qiita', 'Zenn', 'RSS']}
        forceTheme="dark"
      />
    </div>

    <!-- コピーライト -->
    <div class="text-center text-gray-400 dark:text-gray-400">
      <small>&copy; {currentYear} SAKUSPACE. All rights reserved.</small>
    </div>
  </div>
</footer>
