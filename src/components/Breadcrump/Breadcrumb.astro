---
// パスの情報を取得
import { getLocaleFromPathname, localizedPath, uiText, type Locale } from '../../lib/i18n';

const { pathname } = Astro.url;

// ブログ記事のタイトルをpropsとして受け取る
interface Props {
  blogTitle?: string;
  locale?: Locale;
}

const { blogTitle, locale = getLocaleFromPathname(pathname) } = Astro.props;

// パスを分割して配列に変換（最初の空要素を除去）
const pathSegments = pathname
  .split('/')
  .filter(Boolean)
  .filter((segment, index) => !(index === 0 && segment === 'en'));

// パンくずリストの項目を生成
let breadcrumbItems = [
  { label: uiText.breadcrumbHome[locale], path: localizedPath('/', locale) },
  ...pathSegments.map((segment, index) => {
    // パスを構築
    const path = localizedPath(`/${pathSegments.slice(0, index + 1).join('/')}`, locale);

    // ラベルをフォーマット（最初の文字を大文字に、ハイフンをスペースに）
    let label = segment
      .split('-')
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');

    // ブログ記事の詳細ページで、かつブログタイトルが提供されている場合
    if (index === pathSegments.length - 1 && pathSegments[0] === 'blog' && blogTitle) {
      label = blogTitle;
    }

    return { label, path };
  }),
];

// 現在のページがホームの場合はパンくずリストを表示しない
const isHomePage = pathname === '/';
const isLocalizedHomePage = pathname === '/en' || pathname === '/en/';
---

{
  !isHomePage && !isLocalizedHomePage && (
    <nav aria-label={locale === 'ja' ? 'パンくずリスト' : 'Breadcrumb'} class="breadcrumb">
      <div class="breadcrumb__container">
        <ol class="breadcrumb__list">
          {breadcrumbItems.map((item, index) => (
            <li class="breadcrumb__item">
              {index > 0 && <span class="breadcrumb__separator">＞</span>}
              {index === breadcrumbItems.length - 1 ? (
                <span class="breadcrumb__current" aria-current="page">
                  {item.label}
                </span>
              ) : (
                <a href={item.path} class="breadcrumb__link">
                  {item.path === localizedPath('/', locale) && (
                    <span class="breadcrumb__home-icon i-ic-home" aria-hidden="true" />
                  )}
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<style>
  .breadcrumb {
    border-top: 1px solid var(--color-section-border);
    border-color: var(--color-section-border);
    background-color: rgb(255 255 255);
    padding-block: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  :global(html.dark) .breadcrumb {
    background-color: rgb(17 24 39);
  }

  .breadcrumb__container {
    max-width: 1132px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
  }

  .breadcrumb__separator {
    margin-inline: 0.5rem;
    color: rgb(107 114 128);
  }

  :global(html.dark) .breadcrumb__separator {
    color: rgb(156 163 175);
  }

  .breadcrumb__current {
    color: rgb(55 65 81);
  }

  :global(html.dark) .breadcrumb__current {
    color: rgb(209 213 219);
  }

  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    color: rgb(75 85 99);
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(html.dark) .breadcrumb__link {
    color: rgb(156 163 175);
  }

  .breadcrumb__home-icon {
    margin-right: 0.25rem;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  @media (min-width: 1024px) {
    .breadcrumb__link:hover {
      color: rgb(17 24 39);
      text-decoration-line: underline;
    }

    :global(html.dark) .breadcrumb__link:hover {
      color: rgb(229 231 235);
    }
  }
</style>
