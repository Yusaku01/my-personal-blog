---
interface Props {
  showHero?: boolean;
  title?: string;
}

const { showHero = true, title = 'SAKUSPACE' } = Astro.props;
---

{
  showHero && (
    <div class="hero-section" role="banner">
      <div class="hero-section__container">
        <h1 class="hero-section__title">{title}</h1>
      </div>
    </div>
  )
}

<style>
  .hero-section {
    position: relative;
    background-color: rgb(255 255 255);
    padding-block: 10rem;
  }

  :global(html.dark) .hero-section {
    background-color: rgb(17 24 39);
  }

  .hero-section__container {
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: 1rem;
    text-align: center;
  }

  .hero-section__title {
    color: var(--color-heading);
    font-size: var(--fs-h1);
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  @media (min-width: 640px) {
    .hero-section {
      padding-block: 16.25rem;
    }
  }
</style>
