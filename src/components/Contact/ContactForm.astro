---
import type { ContactActionResult } from '../../lib/contact/contactAction';
import type { Locale } from '../../lib/i18n';

type ContactFormText = {
  intro: string;
  introSub: string;
  sentTitle: string;
  sentBody: string;
  sentAction: string;
  name: string;
  email: string;
  subject: string;
  message: string;
  required: string;
  submit: string;
  submitting: string;
  retry: string;
  turnstileMissing: string;
  genericError: string;
};

type Props = {
  action: string;
  locale: Locale;
  sent: boolean;
  turnstileSiteKey: string;
  result?: { data?: ContactActionResult; error?: unknown } | undefined;
};

const { action, locale, sent, turnstileSiteKey, result } = Astro.props;

const text: Record<Locale, ContactFormText> = {
  ja: {
    intro: 'ご質問やお問い合わせがありましたら、以下のフォームからご連絡ください。',
    introSub: '可能な限り早くご返信いたします。',
    sentTitle: '送信完了',
    sentBody: 'お問い合わせありがとうございます。できるだけ早くご返信いたします。',
    sentAction: '新しく問い合わせる',
    name: 'お名前',
    email: 'メールアドレス',
    subject: '件名',
    message: 'メッセージ',
    required: '必須',
    submit: '送信する',
    submitting: '送信中...',
    retry: '入力内容を確認してください。',
    turnstileMissing: 'Turnstile のサイトキーが未設定です。設定後に送信を有効化してください。',
    genericError: '送信に失敗しました。時間をおいて再度お試しください。',
  },
  en: {
    intro: 'If you have a question or inquiry, please use the form below.',
    introSub: 'I will reply as soon as I can.',
    sentTitle: 'Message sent',
    sentBody: 'Thank you for your message. I will reply as soon as I can.',
    sentAction: 'Send another message',
    name: 'Name',
    email: 'Email',
    subject: 'Subject',
    message: 'Message',
    required: 'Required',
    submit: 'Send',
    submitting: 'Sending...',
    retry: 'Please check your input.',
    turnstileMissing:
      'Turnstile site key is not configured. Submissions will be enabled after setup.',
    genericError: 'Could not send your message. Please try again later.',
  },
};

const t = text[locale];
const contactPath = locale === 'ja' ? '/contact' : '/en/contact';
const failedSubmission = result?.data && !result.data.ok ? result.data : null;
const values = failedSubmission?.values ?? {
  name: '',
  email: '',
  subject: '',
  message: '',
};
const fieldErrors = failedSubmission?.fieldErrors ?? {};
const formError = failedSubmission?.message ?? (result?.error ? t.genericError : null);

const fields = {
  name: {
    id: 'contact-name',
    label: t.name,
    type: 'text',
    autocomplete: 'name',
    value: values.name,
    error: fieldErrors.name?.join(locale === 'ja' ? '、' : ', '),
    maxlength: 80,
  },
  email: {
    id: 'contact-email',
    label: t.email,
    type: 'email',
    autocomplete: 'email',
    value: values.email,
    error: fieldErrors.email?.join(locale === 'ja' ? '、' : ', '),
    maxlength: 254,
  },
  subject: {
    id: 'contact-subject',
    label: t.subject,
    type: 'text',
    autocomplete: 'off',
    value: values.subject,
    error: fieldErrors.subject?.join(locale === 'ja' ? '、' : ', '),
    maxlength: 120,
  },
} as const;

const messageError = fieldErrors.message?.join(locale === 'ja' ? '、' : ', ');
---

<div class="contact-container">
  {
    sent && (
      <div class="contact-sent" role="status" aria-live="polite">
        <h2 class="contact-sent-title">{t.sentTitle}</h2>
        <p class="contact-sent-body">{t.sentBody}</p>
        <a class="contact-sent-action" href={contactPath}>
          {t.sentAction}
        </a>
      </div>
    )
  }

  {
    !sent && (
      <>
        <p class="contact-intro">
          {t.intro}
          <br class="contact-intro-break" />
          {t.introSub}
        </p>

        <form method="POST" action={action} data-contact-form novalidate class="contact-form">
          <div
            data-contact-status
            class="contact-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          />

          {formError && (
            <p data-contact-error-summary class="contact-error-summary" role="alert">
              {formError}
            </p>
          )}
          {!formError && (
            <p data-contact-error-summary hidden class="contact-error-summary" role="alert" />
          )}

          {Object.entries(fields).map(([name, field]) => (
            <div class="contact-field">
              <label for={field.id} class="contact-label">
                <span class="contact-label-name">{field.label}</span>
                <span class="contact-required">{t.required}</span>
              </label>
              <input
                id={field.id}
                name={name}
                type={field.type}
                autocomplete={field.autocomplete}
                maxlength={field.maxlength}
                value={field.value}
                required
                data-contact-control
                data-contact-label={field.label}
                aria-invalid={field.error ? 'true' : undefined}
                aria-describedby={`${field.id}-error`}
                aria-errormessage={`${field.id}-error`}
                class="contact-control"
              />
              <p id={`${field.id}-error`} class="contact-error" data-contact-field-error>
                {field.error}
              </p>
            </div>
          ))}

          <div class="contact-field">
            <label for="contact-message" class="contact-label">
              <span class="contact-label-name">{t.message}</span>
              <span class="contact-required">{t.required}</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="8"
              maxlength="4000"
              required
              data-contact-control
              data-contact-label={t.message}
              aria-invalid={messageError ? 'true' : undefined}
              aria-describedby="contact-message-error contact-message-count"
              aria-errormessage="contact-message-error"
              class="contact-control contact-textarea"
            >
              {values.message}
            </textarea>
            <div class="contact-message-meta">
              <p id="contact-message-error" class="contact-error" data-contact-field-error>
                {messageError}
              </p>
              <p id="contact-message-count" class="contact-message-count">
                <span data-contact-message-count>{values.message.length}</span>/4000
              </p>
            </div>
          </div>

          {turnstileSiteKey ? (
            <div class="contact-verification">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
            </div>
          ) : (
            <p class="contact-verification-warning">{t.turnstileMissing}</p>
          )}

          <div class="contact-actions">
            <button
              type="submit"
              data-contact-submit
              data-default-label={t.submit}
              data-pending-label={t.submitting}
              data-invalid-message={t.retry}
              data-turnstile-message={t.turnstileMissing}
              class="contact-submit"
              disabled={!turnstileSiteKey}
            >
              {t.submit}
            </button>
          </div>
        </form>
      </>
    )
  }
</div>

<style>
  .contact-form,
  .contact-sent {
    margin-inline: auto;
    max-width: 42rem;
  }

  .contact-intro {
    color: rgb(55 65 81);
    line-height: 1.625;
    margin-bottom: 2rem;
    text-align: center;
  }

  .contact-intro-break {
    display: none;
  }

  .contact-form > :global(:not([hidden]) ~ :not([hidden])) {
    margin-top: 1.5rem;
    margin-bottom: 0;
  }

  .contact-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .contact-label {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .contact-label-name {
    color: rgb(55 65 81);
    font-weight: 700;
  }

  .contact-required {
    background-color: rgb(229 231 235);
    border-radius: 0.375rem;
    color: rgb(55 65 81);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1rem;
    padding: 0.125rem 0.5rem;
  }

  .contact-textarea {
    max-height: 20rem;
    resize: vertical;
  }

  .contact-message-meta {
    align-items: flex-start;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 0.25rem;
  }

  .contact-message-count {
    color: rgb(107 114 128);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .contact-verification {
    display: grid;
    justify-content: center;
  }

  .contact-verification-warning {
    background-color: rgb(255 251 235);
    border: 1px solid rgb(253 230 138);
    border-radius: 0.375rem;
    color: rgb(180 83 9);
    font-size: 0.875rem;
    line-height: 1.25rem;
    padding: 0.75rem;
  }

  .contact-actions {
    text-align: center;
  }

  .contact-submit {
    background-color: rgb(31 41 55);
    border-radius: 0.375rem;
    color: rgb(255 255 255);
    font-weight: 700;
    letter-spacing: 0.025em;
    padding: 0.75rem 1.5rem;
    transition-property:
      color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-submit:focus {
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow:
      0 0 0 2px rgb(255 255 255),
      0 0 0 4px rgb(107 114 128);
  }

  .contact-submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  :global(html.dark) .contact-intro {
    color: rgb(229 231 235);
  }

  :global(html.dark) .contact-label-name {
    color: rgb(255 255 255);
  }

  :global(html.dark) .contact-message-count {
    color: rgb(156 163 175);
  }

  :global(html.dark) .contact-submit {
    background-color: rgb(255 255 255);
    color: rgb(17 24 39);
  }

  :global(html.dark) .contact-submit:focus {
    box-shadow:
      0 0 0 2px rgb(209 213 219),
      0 0 0 4px rgb(209 213 219);
  }

  @media (min-width: 640px) {
    .contact-intro-break {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .contact-container {
      padding-inline: 2rem;
    }

    .contact-submit:hover {
      background-color: rgb(55 65 81);
    }

    :global(html.dark) .contact-submit:hover {
      background-color: rgb(209 213 219);
    }
  }

  .contact-control {
    width: 100%;
    border: 1px solid rgb(209 213 219);
    border-radius: 0.375rem;
    background: rgb(255 255 255);
    color: rgb(17 24 39);
    font-size: 1rem;
    min-height: 3rem;
    padding: 0.75rem;
    transition:
      border-color 160ms ease,
      outline-color 160ms ease,
      background-color 160ms ease;
  }

  .contact-control:focus-visible {
    border-color: rgb(75 85 99);
    outline: 2px solid rgb(75 85 99 / 0.62);
    outline-offset: 2px;
  }

  .contact-control[aria-invalid='true'] {
    border-color: rgb(220 38 38);
    background-color: rgb(254 242 242);
    outline: 2px solid rgb(220 38 38 / 0.55);
    outline-offset: 2px;
  }

  .contact-control[aria-invalid='true']:focus-visible {
    border-color: rgb(220 38 38);
    outline-color: rgb(220 38 38);
  }

  .contact-error-summary {
    border: 1px solid rgb(254 202 202);
    border-radius: 0.375rem;
    background: rgb(254 242 242);
    color: rgb(185 28 28);
    font-size: 0.875rem;
    padding: 1rem;
  }

  .contact-error {
    color: rgb(220 38 38);
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }

  .contact-error:empty {
    display: none;
  }

  :global(html.dark) .contact-control {
    border-color: rgb(75 85 99);
    background: rgb(249 250 251);
    color: rgb(17 24 39);
  }

  :global(html.dark) .contact-control:focus-visible {
    border-color: rgb(203 213 225);
    outline-color: rgb(203 213 225 / 0.8);
  }

  :global(html.dark) .contact-control[aria-invalid='true'] {
    border-color: rgb(248 113 113);
    background: rgb(255 241 242);
    outline: 3px solid rgb(248 113 113 / 0.75);
    outline-offset: 2px;
  }

  :global(html.dark) .contact-control[aria-invalid='true']:focus-visible {
    border-color: rgb(252 165 165);
    outline-color: rgb(252 165 165);
  }

  :global(html.dark) .contact-error {
    color: rgb(252 165 165);
  }

  :global(html.dark) .contact-error-summary {
    border-color: rgb(248 113 113 / 0.65);
    background: rgb(127 29 29 / 0.34);
    color: rgb(254 202 202);
  }

  .contact-sent {
    border-width: 1px;
    border-style: solid;
    border-radius: 0.375rem;
    padding: 2rem;
    text-align: center;
    border-color: rgb(187 247 208);
    background: rgb(240 253 244);
    color: rgb(22 101 52);
  }

  .contact-sent-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 2rem;
    margin-bottom: 0.75rem;
  }

  .contact-sent-body {
    line-height: 1.625;
  }

  .contact-sent-action {
    display: inline-flex;
    margin-top: 1.5rem;
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      outline-color 160ms ease;
  }

  .contact-sent-action:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .contact-sent-action:hover {
    background: rgb(22 101 52);
    color: rgb(255 255 255);
  }

  :global(html.dark) .contact-sent {
    border-color: rgb(74 222 128 / 0.65);
    background: rgb(20 83 45 / 0.36);
    color: rgb(220 252 231);
  }

  :global(html.dark) .contact-sent-action:hover {
    background: rgb(220 252 231);
    color: rgb(20 83 45);
  }
</style>

<script>
  import { installContactFormEnhancements } from '../../lib/contact/formEnhancements';

  installContactFormEnhancements();
</script>
