---
import ThemeToggle from '../Theme/ThemeToggle.astro';
import SocialIcons from '../Sns/SocialIcons.astro';
import {
  getLanguageSwitchHref,
  getLocaleFromPathname,
  localeMeta,
  navItemsForLocale,
  uiText,
  localizedPath,
  type Locale,
} from '../../lib/i18n';

const { pathname } = Astro.url;
const { locale = getLocaleFromPathname(pathname) } = Astro.props as { locale?: Locale };

const navItems = navItemsForLocale(locale);
const languageItems = [
  { locale: 'ja' as const, href: getLanguageSwitchHref(pathname, 'ja', Astro.url.search) },
  { locale: 'en' as const, href: getLanguageSwitchHref(pathname, 'en', Astro.url.search) },
];

// アクティブなリンクかどうかを判定する関数
const isActiveLink = (href: string) => {
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header
  id="header"
  class="fixed w-full top-0 bg-white dark:bg-gray-900 z-50 transition-transform duration-300"
>
  <div class="container-lg mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a
        href={localizedPath('/', locale)}
        class="text-xl font-bold tracking-[0.3em] text-gray-800 dark:text-white"
      >
        SAKUSPACE
      </a>

      <nav class="flex items-center flex-row-reverse lg:flex-row gap-4">
        <!-- デスクトップナビゲーション -->
        <div class="hidden lg:flex items-center gap-4">
          {
            navItems.map((item) => {
              const isActive = isActiveLink(item.href);
              const baseUnoClasses = 'px-4 py-2 text-gray-800 dark:text-white relative';
              const customClasses = `nav-link ${isActive ? 'nav-link-active' : 'nav-link-hoverable'}`;

              return (
                <a
                  href={item.href}
                  class={`${baseUnoClasses} ${customClasses}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.text}
                </a>
              );
            })
          }
        </div>

        <div
          class="hidden lg:flex items-center gap-2 border-l border-gray-300 pl-4 text-sm font-bold tracking-wider text-gray-800 dark:border-gray-600 dark:text-white"
          aria-label="Language switcher"
        >
          {
            languageItems.map((item, index) => (
              <>
                {index > 0 && <span class="text-gray-400 dark:text-gray-500">|</span>}
                <a
                  href={item.href}
                  class:list={[
                    'px-1 underline-offset-4 transition-colors hover:underline',
                    {
                      'opacity-100': item.locale === locale,
                      'opacity-55': item.locale !== locale,
                    },
                  ]}
                  aria-current={item.locale === locale ? 'page' : undefined}
                  lang={localeMeta[item.locale].htmlLang}
                >
                  {localeMeta[item.locale].label}
                </a>
              </>
            ))
          }
        </div>

        <!-- モバイルメニューボタン -->
        <button
          id="menuButton"
          type="button"
          class="lg:hidden px-4 py-2 text-gray-800 dark:text-white lg:hover:bg-gray-800 lg:hover:text-white transition-colors duration-300 rounded-[21px] border dark:border-white border-gray-800"
          aria-controls="mobileMenu"
          aria-expanded="false"
        >
          {uiText.menu.button}
        </button>

        <ThemeToggle />
      </nav>
    </div>
  </div>

  <!-- モバイルメニュー -->
  <div
    id="mobileMenu"
    class="mobile-menu fixed inset-0 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm z-50"
    data-state="closed"
    role="dialog"
    aria-modal="true"
    aria-label={uiText.menu.label[locale]}
    aria-hidden="true"
    inert
  >
    <div
      class="mobile-menu-panel relative mx-auto px-4 py-8 bg-white dark:bg-gray-900 z-[9999] h-screen overflow-y-auto"
    >
      <button
        id="closeButton"
        type="button"
        class="absolute top-4 right-4 p-2 text-gray-800 dark:text-white lg:hover:bg-gray-800 lg:hover:text-white transition-colors duration-300"
      >
        <i class="i-ic-round-close text-2xl" aria-hidden="true"></i>
        <span class="sr-only">{uiText.menu.close[locale]}</span>
      </button>
      <div
        class="flex flex-col items-center gap-6 mt-16 min-h-[calc(100vh-12rem)] max-h-[calc(100vh-4rem)]"
      >
        <div class="flex flex-col items-center gap-6">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`px-4 py-2 text-gray-800 dark:text-white text-xl ${isActiveLink(item.href) ? 'font-bold' : ''}`}
              >
                {item.text}
              </a>
            ))
          }
        </div>
        <div
          class="flex items-center gap-3 text-lg font-bold tracking-wider text-gray-800 dark:text-white"
          aria-label="Language switcher"
        >
          {
            languageItems.map((item, index) => (
              <>
                {index > 0 && <span class="text-gray-400 dark:text-gray-500">|</span>}
                <a
                  href={item.href}
                  class:list={[
                    'px-2 py-1 underline-offset-4',
                    {
                      'opacity-100 underline': item.locale === locale,
                      'opacity-55': item.locale !== locale,
                    },
                  ]}
                  aria-current={item.locale === locale ? 'page' : undefined}
                  lang={localeMeta[item.locale].htmlLang}
                >
                  {localeMeta[item.locale].label}
                </a>
              </>
            ))
          }
        </div>
        <div class="my-8">
          <p class="text-center text-gray-800 dark:text-white mb-3">{uiText.menu.follow}</p>
          <SocialIcons variant="default" class="justify-center" iconClass="h-7 w-7" />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative; /* Needed for absolute positioning of ::after */
    transition: color 0.3s; /* Optional: Keep color transition */
  }

  /* Base style for the underline */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0; /* Adjust as needed, maybe slightly above bottom edge */
    height: 2px; /* Underline thickness */
    background-color: theme('colors.gray.800'); /* Use theme colors */
    transition: width 0.3s ease-out; /* Animate only width */
    width: 0; /* Default width is 0 */
  }

  /* Dark mode underline color */
  :global(html.dark) .nav-link::after {
    background-color: theme('colors.white');
  }

  /* Style for hoverable (non-active) links */
  .nav-link-hoverable:hover::after {
    width: 100%; /* Expand width on hover */
  }

  /* Style for active links */
  .nav-link-active::after {
    width: 100%; /* Always full width */
    transition: none; /* No transition needed for active state */
  }

  .mobile-menu {
    opacity: 0;
    pointer-events: none;
    transform: translateX(100%);
    transition:
      transform 0.3s ease,
      opacity 0.2s ease,
      visibility 0s linear 0.3s;
    visibility: hidden;
  }

  .mobile-menu[data-state='open'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
    visibility: visible;
  }
</style>

<!-- <div class="h-16"></div> -->

<script is:inline>
  let controller = new AbortController();

  const getFocusableElements = (container) =>
    Array.from(
      container.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
    );

  const trapFocus = (container, event) => {
    const focusable = getFocusableElements(container);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  };

  const setupHeaderInteractions = () => {
    controller.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.getElementById('header');
    const menuButton = document.getElementById('menuButton');
    const closeButton = document.getElementById('closeButton');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileMenuPanel = mobileMenu?.querySelector('.mobile-menu-panel');
    let lastScroll = 0;

    const handleScroll = () => {
      const currentScroll = window.scrollY;

      if (currentScroll <= 0) {
        header?.classList.remove('-translate-y-full');
      }

      if (currentScroll > lastScroll && currentScroll > 80) {
        header?.classList.add('-translate-y-full');
      } else {
        header?.classList.remove('-translate-y-full');
      }

      lastScroll = currentScroll;
    };

    window.addEventListener('scroll', handleScroll, { signal, passive: true });

    if (menuButton && closeButton && mobileMenu && mobileMenuPanel) {
      let isMenuOpen = false;

      const setMenuState = (open) => {
        isMenuOpen = open;
        mobileMenu.dataset.state = open ? 'open' : 'closed';
        mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
        menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');

        if (open) {
          mobileMenu.removeAttribute('inert');
          document.body.style.overflow = 'hidden';
        } else {
          mobileMenu.setAttribute('inert', '');
          document.body.style.overflow = '';
        }
      };

      const openMenu = () => {
        window.dispatchEvent(new CustomEvent('toc-panel:close'));
        setMenuState(true);
        closeButton.focus();
      };

      const closeMenu = () => {
        if (!isMenuOpen) return;
        setMenuState(false);
        menuButton.focus();
      };

      setMenuState(false);
      menuButton.addEventListener('click', openMenu, { signal });
      closeButton.addEventListener('click', closeMenu, { signal });
      mobileMenu.addEventListener(
        'click',
        (event) => {
          if (event.target === mobileMenu) {
            closeMenu();
          }
        },
        { signal }
      );
      mobileMenuPanel.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();
        },
        { signal }
      );
      mobileMenu.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('a[href]') && isMenuOpen) {
            closeMenu();
          }
        },
        { signal }
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (!isMenuOpen) return;

          if (event.key === 'Escape') {
            event.preventDefault();
            closeMenu();
            return;
          }

          if (event.key === 'Tab') {
            trapFocus(mobileMenu, event);
          }
        },
        { signal }
      );
      window.addEventListener('header-menu:close', closeMenu, { signal });
    }

    const themeToggle = document.getElementById('themeToggle');
    if (themeToggle) {
      const handleThemeToggle = () => {
        const element = document.documentElement;
        element.classList.toggle('dark');
        const isDark = element.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        window.dispatchEvent(new Event('themechange'));
      };

      themeToggle.addEventListener('click', handleThemeToggle, { signal });
    }
  };

  const init = () => {
    setupHeaderInteractions();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>
