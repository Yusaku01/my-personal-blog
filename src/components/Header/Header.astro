---
import ThemeToggle from '../Theme/ThemeToggle.astro';
import SocialIcons from '../Sns/SocialIcons.astro';
import {
  getLanguageSwitchHref,
  getLocaleFromPathname,
  localeMeta,
  navItemsForLocale,
  uiText,
  localizedPath,
  type Locale,
} from '../../lib/i18n';

const { pathname } = Astro.url;
const { locale = getLocaleFromPathname(pathname) } = Astro.props as { locale?: Locale };

const navItems = navItemsForLocale(locale);
const languageItems = [
  { locale: 'ja' as const, href: getLanguageSwitchHref(pathname, 'ja', Astro.url.search) },
  { locale: 'en' as const, href: getLanguageSwitchHref(pathname, 'en', Astro.url.search) },
];

// アクティブなリンクかどうかを判定する関数
const isActiveLink = (href: string) => {
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header id="header" class="site-header">
  <div class="header-container">
    <div class="header-bar">
      <a href={localizedPath('/', locale)} class="header-brand"> SAKUSPACE </a>

      <nav class="header-nav">
        <!-- デスクトップナビゲーション -->
        <div class="header-desktop-links">
          {
            navItems.map((item) => {
              const isActive = isActiveLink(item.href);
              const customClasses = `nav-link ${isActive ? 'nav-link-active' : 'nav-link-hoverable'}`;

              return (
                <a
                  href={item.href}
                  class={customClasses}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.text}
                </a>
              );
            })
          }
        </div>

        <div class="header-languages" aria-label="Language switcher">
          {
            languageItems.map((item, index) => (
              <>
                {index > 0 && <span class="header-language-separator">|</span>}
                <a
                  href={item.href}
                  class:list={[
                    'header-language-link',
                    {
                      'header-language-link--inactive': item.locale !== locale,
                    },
                  ]}
                  aria-current={item.locale === locale ? 'page' : undefined}
                  lang={localeMeta[item.locale].htmlLang}
                >
                  {localeMeta[item.locale].label}
                </a>
              </>
            ))
          }
        </div>

        <!-- モバイルメニューボタン -->
        <button
          id="menuButton"
          type="button"
          class="header-menu-button"
          aria-controls="mobileMenu"
          aria-expanded="false"
        >
          {uiText.menu.button}
        </button>

        <ThemeToggle />
      </nav>
    </div>
  </div>

  <!-- モバイルメニュー -->
  <div
    id="mobileMenu"
    class="mobile-menu"
    data-state="closed"
    role="dialog"
    aria-modal="true"
    aria-label={uiText.menu.label[locale]}
    aria-hidden="true"
    inert
  >
    <div class="mobile-menu-panel">
      <button id="closeButton" type="button" class="mobile-menu-close">
        <i class="ui-icon ui-icon--close mobile-menu-close-icon" aria-hidden="true"></i>
        <span class="header-sr-only">{uiText.menu.close[locale]}</span>
      </button>
      <div class="mobile-menu-content">
        <div class="mobile-menu-links">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'mobile-menu-link',
                  { 'mobile-menu-link--active': isActiveLink(item.href) },
                ]}
              >
                {item.text}
              </a>
            ))
          }
        </div>
        <div class="mobile-menu-languages" aria-label="Language switcher">
          {
            languageItems.map((item, index) => (
              <>
                {index > 0 && <span class="header-language-separator">|</span>}
                <a
                  href={item.href}
                  class:list={[
                    'mobile-menu-language-link',
                    {
                      'mobile-menu-language-link--active': item.locale === locale,
                      'header-language-link--inactive': item.locale !== locale,
                    },
                  ]}
                  aria-current={item.locale === locale ? 'page' : undefined}
                  lang={localeMeta[item.locale].htmlLang}
                >
                  {localeMeta[item.locale].label}
                </a>
              </>
            ))
          }
        </div>
        <div class="mobile-menu-socials">
          <p class="mobile-menu-follow">{uiText.menu.follow}</p>
          <SocialIcons variant="default" />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    --header-background: rgb(255 255 255);
    --header-color: rgb(31 41 55);
    --header-language-border: rgb(209 213 219);
    --header-language-separator: rgb(156 163 175);
    --header-menu-background: rgb(255 255 255 / 0.95);
    background-color: var(--header-background);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header--hidden {
    transform: translate3d(0, -100%, 0);
  }

  :global(html.dark) .site-header {
    --header-background: rgb(17 24 39);
    --header-color: rgb(255 255 255);
    --header-language-border: rgb(75 85 99);
    --header-language-separator: rgb(107 114 128);
    --header-menu-background: rgb(31 41 55 / 0.95);
  }

  .header-container {
    margin-inline: auto;
    max-width: 1132px;
    padding-inline: 1rem;
  }

  .header-bar {
    align-items: center;
    display: flex;
    height: 4rem;
    justify-content: space-between;
  }

  .header-brand {
    color: var(--header-color);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    line-height: 1.75rem;
  }

  .header-nav {
    align-items: center;
    display: flex;
    flex-direction: row-reverse;
    gap: 1rem;
  }

  .header-desktop-links,
  .header-languages {
    align-items: center;
    display: none;
  }

  .header-desktop-links {
    gap: 1rem;
  }

  .header-languages {
    border-left-width: 1px;
    border-color: var(--header-language-border);
    color: var(--header-color);
    font-size: 0.875rem;
    font-weight: 700;
    gap: 0.5rem;
    letter-spacing: 0.05em;
    line-height: 1.25rem;
    padding-left: 1rem;
  }

  .header-language-separator {
    color: var(--header-language-separator);
  }

  .header-language-link {
    padding-inline: 0.25rem;
    text-underline-offset: 4px;
    transition-property:
      color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-language-link:hover {
    text-decoration-line: underline;
  }

  .header-language-link--inactive {
    opacity: 0.55;
  }

  .header-menu-button,
  .mobile-menu-close {
    color: var(--header-color);
    transition-property:
      color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-duration: 300ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-menu-button {
    border: 1px solid var(--header-color);
    border-radius: 21px;
    padding: 0.5rem 1rem;
  }

  .mobile-menu-panel {
    background-color: var(--header-background);
    height: 100vh;
    margin-inline: auto;
    overflow-y: auto;
    padding: 2rem 1rem;
    position: relative;
    z-index: 9999;
  }

  .mobile-menu-close {
    padding: 0.5rem;
    position: absolute;
    right: 1rem;
    top: 1rem;
  }

  .mobile-menu-close-icon {
    font-size: 1.5rem;
    line-height: 2rem;
  }

  .header-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .mobile-menu-content,
  .mobile-menu-links {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-menu-content {
    margin-top: 4rem;
    max-height: calc(100vh - 4rem);
    min-height: calc(100vh - 12rem);
  }

  .mobile-menu-link {
    color: var(--header-color);
    font-size: 1.25rem;
    line-height: 1.75rem;
    padding: 0.5rem 1rem;
  }

  .mobile-menu-link--active {
    font-weight: 700;
  }

  .mobile-menu-languages {
    align-items: center;
    color: var(--header-color);
    display: flex;
    font-size: 1.125rem;
    font-weight: 700;
    gap: 0.75rem;
    letter-spacing: 0.05em;
    line-height: 1.75rem;
  }

  .mobile-menu-language-link {
    padding: 0.25rem 0.5rem;
    text-underline-offset: 4px;
  }

  .mobile-menu-language-link--active {
    text-decoration-line: underline;
  }

  .mobile-menu-socials {
    margin-block: 2rem;
  }

  .mobile-menu-socials :global(.social-icons) {
    justify-content: center;
  }

  .mobile-menu-follow {
    color: var(--header-color);
    margin-bottom: 0.75rem;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .header-nav {
      flex-direction: row;
    }

    .header-desktop-links,
    .header-languages {
      display: flex;
    }

    .header-menu-button {
      display: none;
    }

    .header-menu-button:hover,
    .mobile-menu-close:hover {
      background-color: rgb(31 41 55);
      color: rgb(255 255 255);
    }
  }

  .nav-link {
    color: var(--header-color);
    padding: 0.5rem 1rem;
    position: relative; /* Needed for absolute positioning of ::after */
    transition: color 0.3s; /* Optional: Keep color transition */
  }

  /* Base style for the underline */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0; /* Adjust as needed, maybe slightly above bottom edge */
    height: 2px; /* Underline thickness */
    background-color: var(--header-color); /* Use theme colors */
    transition: width 0.3s ease-out; /* Animate only width */
    width: 0; /* Default width is 0 */
  }

  /* Style for hoverable (non-active) links */
  .nav-link-hoverable:hover::after {
    width: 100%; /* Expand width on hover */
  }

  /* Style for active links */
  .nav-link-active::after {
    width: 100%; /* Always full width */
    transition: none; /* No transition needed for active state */
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background-color: var(--header-menu-background);
    backdrop-filter: blur(4px);
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transform: translateX(100%);
    transition:
      transform 0.3s ease,
      opacity 0.2s ease,
      visibility 0s linear 0.3s;
    visibility: hidden;
  }

  .mobile-menu[data-state='open'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
    visibility: visible;
  }
</style>

<script is:inline>
  let controller = new AbortController();

  const getFocusableElements = (container) =>
    Array.from(
      container.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
    );

  const trapFocus = (container, event) => {
    const focusable = getFocusableElements(container);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  };

  const setupHeaderInteractions = () => {
    controller.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.getElementById('header');
    const menuButton = document.getElementById('menuButton');
    const closeButton = document.getElementById('closeButton');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileMenuPanel = mobileMenu?.querySelector('.mobile-menu-panel');
    let lastScroll = 0;

    const handleScroll = () => {
      const currentScroll = window.scrollY;

      if (currentScroll <= 0) {
        header?.classList.remove('site-header--hidden');
      }

      if (currentScroll > lastScroll && currentScroll > 80) {
        header?.classList.add('site-header--hidden');
      } else {
        header?.classList.remove('site-header--hidden');
      }

      lastScroll = currentScroll;
    };

    window.addEventListener('scroll', handleScroll, { signal, passive: true });

    if (menuButton && closeButton && mobileMenu && mobileMenuPanel) {
      let isMenuOpen = false;

      const setMenuState = (open) => {
        isMenuOpen = open;
        mobileMenu.dataset.state = open ? 'open' : 'closed';
        mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
        menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');

        if (open) {
          mobileMenu.removeAttribute('inert');
          document.body.style.overflow = 'hidden';
        } else {
          mobileMenu.setAttribute('inert', '');
          document.body.style.overflow = '';
        }
      };

      const openMenu = () => {
        window.dispatchEvent(new CustomEvent('toc-panel:close'));
        setMenuState(true);
        closeButton.focus();
      };

      const closeMenu = () => {
        if (!isMenuOpen) return;
        setMenuState(false);
        menuButton.focus();
      };

      setMenuState(false);
      menuButton.addEventListener('click', openMenu, { signal });
      closeButton.addEventListener('click', closeMenu, { signal });
      mobileMenu.addEventListener(
        'click',
        (event) => {
          if (event.target === mobileMenu) {
            closeMenu();
          }
        },
        { signal }
      );
      mobileMenuPanel.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();
        },
        { signal }
      );
      mobileMenu.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('a[href]') && isMenuOpen) {
            closeMenu();
          }
        },
        { signal }
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (!isMenuOpen) return;

          if (event.key === 'Escape') {
            event.preventDefault();
            closeMenu();
            return;
          }

          if (event.key === 'Tab') {
            trapFocus(mobileMenu, event);
          }
        },
        { signal }
      );
      window.addEventListener('header-menu:close', closeMenu, { signal });
    }

    const themeToggle = document.getElementById('themeToggle');
    if (themeToggle) {
      const handleThemeToggle = () => {
        const element = document.documentElement;
        element.classList.toggle('dark');
        const isDark = element.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        window.dispatchEvent(new Event('themechange'));
      };

      themeToggle.addEventListener('click', handleThemeToggle, { signal });
    }
  };

  const init = () => {
    setupHeaderInteractions();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
</script>
