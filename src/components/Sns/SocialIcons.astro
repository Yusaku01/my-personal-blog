---
import { getEntry } from 'astro:content';

interface Props {
  class?: string;
  variant?: 'default' | 'minimal';
  networks?: string[];
  /** 表示対象を限定 */
  include?: string[];
  /** 表示対象から除外 */
  exclude?: string[];
  /** 表示順を上書き（未指定はデータ順） */
  order?: string[];
  forceTheme?: 'light' | 'dark';
}

const {
  class: className = '',
  variant = 'default',
  networks,
  include,
  exclude = [],
  order,
  forceTheme,
} = Astro.props;

// 単一ソース
const profileEntry = await getEntry('profile', 'main');

if (!profileEntry) {
  throw new Error('Profile entry not found: src/content/profile/main.mdx');
}

const allLinks = profileEntry.data.socialLinks;

// include/networks → 絞り込み対象
const includeSet = new Set((include ?? networks ?? allLinks.map((s) => s.name)) as string[]);
let filtered = allLinks.filter((s) => includeSet.has(s.name));

// exclude 適用
if ((exclude?.length ?? 0) > 0) {
  const ex = new Set(exclude);
  filtered = filtered.filter((s) => !ex.has(s.name));
}

// order 指定がある場合はそれに従って並び替え（未指定は元順を維持）
if ((order?.length ?? 0) > 0) {
  const idx = new Map(order!.map((name, i) => [name, i] as const));
  filtered = filtered
    .map((s, i) => ({ s, i }))
    .sort((a, b) => {
      const ai = idx.has(a.s.name) ? (idx.get(a.s.name) as number) : Number.POSITIVE_INFINITY;
      const bi = idx.has(b.s.name) ? (idx.get(b.s.name) as number) : Number.POSITIVE_INFINITY;
      if (ai !== bi) return ai - bi;
      return a.i - b.i; // 未指定同士は元の順序
    })
    .map(({ s }) => s);
}
---

<div
  class:list={['social-icons', `social-icons--${variant}`, className]}
  data-force-theme={forceTheme}
>
  {
    filtered.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.name}
        class="social-icons__link"
        data-social={social.name}
      >
        <img
          src={social.iconLight}
          alt={social.name}
          data-dark-src={social.iconDark}
          data-light-src={social.iconLight}
          class="social-icons__image"
          width="28"
          height="28"
          loading="lazy"
        />
      </a>
    ))
  }
</div>

<style>
  .social-icons {
    --social-icons-spacing: 1.5rem;
    display: flex;
    align-items: center;
  }

  .social-icons--minimal {
    --social-icons-spacing: 0.5rem;
  }

  .social-icons > :not([hidden]) ~ :not([hidden]) {
    margin-right: 0;
    margin-left: var(--social-icons-spacing);
  }

  .social-icons__link {
    width: 1.75rem;
    height: 1.75rem;
    color: rgb(107 114 128);
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icons__link:hover {
    color: rgb(55 65 81);
  }

  .social-icons--minimal .social-icons__link {
    color: rgb(156 163 175);
  }

  .social-icons--minimal .social-icons__link:hover {
    color: rgb(75 85 99);
  }

  :global(html.dark) .social-icons__link {
    color: rgb(156 163 175);
  }

  :global(html.dark) .social-icons__link:hover {
    color: rgb(229 231 235);
  }

  :global(html.dark) .social-icons--minimal .social-icons__link:hover {
    color: rgb(243 244 246);
  }

  .social-icons__image {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>

<script is:inline>
  // Scope everything in an IIFE to avoid redeclaration across reruns.
  (() => {
    const updateIcons = () => {
      const isDark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('.social-icons').forEach((container) => {
        const forceTheme = container.getAttribute('data-force-theme');
        const shouldUseDark = forceTheme === 'dark' || (forceTheme !== 'light' && isDark);

        container.querySelectorAll('img').forEach((icon) => {
          const darkSrc = icon.getAttribute('data-dark-src');
          const lightSrc = icon.getAttribute('data-light-src');
          const src = shouldUseDark ? darkSrc : lightSrc;
          if (src && icon.getAttribute('src') !== src) icon.setAttribute('src', src);
        });
      });
    };

    document.addEventListener('astro:page-load', updateIcons);
    document.addEventListener('astro:after-swap', updateIcons);
    window.addEventListener('themechange', updateIcons);

    // Run once on first evaluation
    updateIcons();
  })();
</script>
