---
import { type Locale } from '../../lib/i18n';

interface Props {
  url: string;
  title: string;
  description?: string;
  class?: string;
  locale?: Locale;
}

const { url, title, class: extraClass = '', locale = 'ja' } = Astro.props;
const shareUrl = `https://twitter.com/share?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const shareText = {
  ja: {
    heading: '記事を共有する',
    xLabel: 'Xで共有',
  },
  en: {
    heading: 'Share this article',
    xLabel: 'Share on X',
  },
} satisfies Record<Locale, { heading: string; xLabel: string }>;
---

<div class:list={['share-buttons', extraClass]}>
  <div class="share-buttons__heading">{shareText[locale].heading}</div>
  <div class="share-buttons__links">
    <a
      href={shareUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={shareText[locale].xLabel}
      class="share-buttons__link"
    >
      <span class="share-buttons__label">{shareText[locale].xLabel}</span>
    </a>
  </div>
</div>

<style>
  .share-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .share-buttons__heading {
    margin-bottom: 0.5rem;
    color: var(--color-heading);
    text-align: center;
  }

  .share-buttons__links {
    display: flex;
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .share-buttons__link {
    position: relative;
    display: flex;
    height: 3.5rem;
    min-width: 10rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    background-color: rgb(0 0 0);
    padding: 0.5rem 1.5rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .share-buttons__link::before {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    background-image: url('/images/icon_x-dark.svg');
    background-repeat: no-repeat;
    background-size: contain;
    content: '';
  }

  .share-buttons__label {
    display: none;
    color: rgb(255 255 255);
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .share-buttons__link:hover {
      opacity: 0.7;
    }

    .share-buttons__label {
      display: block;
    }
  }
</style>
