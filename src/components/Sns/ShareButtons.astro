---
import { type Locale } from '../../lib/i18n';

interface Props {
  url: string;
  title: string;
  description?: string;
  class?: string;
  locale?: Locale;
}

const { url, title, class: extraClass = '', locale = 'ja' } = Astro.props;
const shareUrl = `https://twitter.com/share?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const shareText = {
  ja: {
    heading: '記事を共有する',
    xLabel: 'Xで共有',
  },
  en: {
    heading: 'Share this article',
    xLabel: 'Share on X',
  },
} satisfies Record<Locale, { heading: string; xLabel: string }>;
---

<div class={`flex flex-col items-center gap-4 ${extraClass}`}>
  <div class="text-gray-900 dark:text-white text-center mb-2">{shareText[locale].heading}</div>
  <div class="flex flex-row gap-4 justify-center w-full flex-wrap">
    <a
      href={shareUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={shareText[locale].xLabel}
      class="flex items-center justify-center min-w-40 h-14 rounded-lg bg-black lg:hover:opacity-70 transition-all duration-300 text-lg gap-2 relative px-6 py-2 before:(content-[''] inline-block w-6 h-6 bg-[url('/images/icon_x-dark.svg')] bg-no-repeat bg-contain)"
    >
      <span class="text-white font-medium lg:block hidden">{shareText[locale].xLabel}</span>
    </a>
  </div>
</div>
