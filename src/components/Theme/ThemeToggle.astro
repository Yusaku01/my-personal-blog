---

---

<button id="themeToggle" class="theme-toggle" aria-label="Toggle theme">
  <span class="theme-toggle__label">テーマを切り替える</span>
  <span class="theme-toggle__thumb">
    <svg
      id="sunIcon"
      class="theme-toggle__icon theme-toggle__icon--sun"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      ></path>
    </svg>
    <svg
      id="moonIcon"
      class="theme-toggle__icon theme-toggle__icon--moon"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    align-items: center;
    background-color: var(--color-theme-toggle-track);
    border: 0;
    border-radius: 9999px;
    display: inline-flex;
    inline-size: 3rem;
    block-size: 1.75rem;
    position: relative;
    transition: background-color 150ms;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .theme-toggle__label {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    block-size: 1px;
    inline-size: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
  }

  .theme-toggle__thumb {
    align-items: center;
    background-color: white;
    border-radius: 9999px;
    block-size: 1.25rem;
    display: inline-flex;
    inline-size: 1.25rem;
    justify-content: center;
    translate: 0.25rem;
    transition: translate 200ms ease-in-out;
  }

  :global(html.dark) .theme-toggle__thumb {
    translate: 1.5rem;
  }

  .theme-toggle__icon {
    block-size: 1.25rem;
    inline-size: 1.25rem;
  }

  .theme-toggle__icon--sun {
    color: var(--color-theme-toggle-icon-muted);
    display: none;
  }

  :global(html.dark) .theme-toggle__icon--sun {
    display: block;
  }

  .theme-toggle__icon--moon {
    color: var(--color-theme-toggle-icon);
    display: block;
  }

  :global(html.dark) .theme-toggle__icon--moon {
    display: none;
  }
</style>
