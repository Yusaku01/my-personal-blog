{
  "name": "@example/basics",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm run test:node && pnpm run test:unit",
    "test:node": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.css",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.css --fix",
    "lint:deps": "knip",
    "lint:text": "pnpm run lint:text:blog",
    "lint:text:blog": "node scripts/lint-blog-text.mjs",
    "lint:text:blog:tech": "node scripts/lint-blog-text.mjs --scope tech",
    "lint:text:blog:diary": "node scripts/lint-blog-text.mjs --scope diary",
    "lint:text:ci": "node scripts/lint-blog-text.mjs",
    "perf:measure-fonts": "node scripts/perf/measure-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mermaid:install-browser": "playwright install chromium chromium-headless-shell",
    "generate-ogp": "node scripts/build-ogp.js",
    "build:with-ogp": "pnpm run generate-ogp && pnpm run build",
    "build:cloudflare": "pnpm exec playwright install chromium chromium-headless-shell && pnpm run build:with-ogp",
    "analyze": "ANALYZE=true astro build",
    "db:migrate:local": "wrangler d1 migrations apply CONTACT_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply CONTACT_DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.5",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.3.8",
    "budoux": "^0.7.0",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^2.30.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "open-graph-scraper": "^4.8.1",
    "remark-directive": "^4.0.0",
    "sanitize-filename": "^1.6.3",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/css": "^1.2.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "10.0.1",
    "@iconify-json/ic": "^1.2.2",
    "@playwright/browser-chromium": "1.58.2",
    "@types/hast": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@unocss/astro": "66.6.7",
    "@unocss/autocomplete": "^66.6.7",
    "@unocss/preset-attributify": "^66.6.7",
    "@unocss/preset-icons": "^66.6.7",
    "@unocss/preset-typography": "^66.6.7",
    "@unocss/preset-wind": "^66.6.7",
    "@unocss/preset-wind3": "^66.6.7",
    "@unocss/reset": "^66.6.7",
    "@unocss/transformer-directives": "^66.6.7",
    "@unocss/transformer-variant-group": "^66.6.7",
    "astro-eslint-parser": "1.4.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "^29.0.1",
    "knip": "^6.13.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "^0.12.2",
    "rehype-mermaid": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-git-hooks": "^2.11.1",
    "textlint": "^15.5.2",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "typescript": "^5.6.0",
    "unified": "^11.0.5",
    "unocss": "^66.6.7",
    "vitest": "^4.1.2",
    "wrangler": "4.95.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run format:check && pnpm run lint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{md,css,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "^6.0.1",
      "lodash": "4.17.23",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "yaml-language-server>ajv": "8.18.0"
    }
  },
  "description": "このプロジェクトは、Astroを使用して構築された個人ブログサイトです。",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
