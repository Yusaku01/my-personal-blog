{
  "name": "@example/basics",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/update-environment.js",
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm run test:node && pnpm run test:unit",
    "test:node": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mermaid:install-browser": "playwright install chromium",
    "generate-ogp": "node scripts/build-ogp.js",
    "build:with-ogp": "pnpm run generate-ogp && pnpm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.1",
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.0.4",
    "budoux": "^0.7.0",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^2.30.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "open-graph-scraper": "^4.8.1",
    "remark-directive": "^4.0.0",
    "sanitize-filename": "^1.6.3",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@iconify-json/ic": "^1.2.2",
    "@types/hast": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@unocss/autocomplete": "^66.5.10",
    "@unocss/preset-attributify": "^66.5.10",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-typography": "^66.5.10",
    "@unocss/preset-wind": "^66.5.10",
    "@unocss/preset-wind3": "^66.6.0",
    "@unocss/reset": "^66.6.0",
    "@unocss/transformer-directives": "^66.5.10",
    "@unocss/transformer-variant-group": "^66.5.10",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.31.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.2.9",
    "playwright": "^1.58.2",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "^0.12.2",
    "rehype-mermaid": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.0",
    "unified": "^11.0.5",
    "unocss": "^66.5.10",
    "vitest": "^4.0.18",
    "wrangler": "4.72.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run format:check && pnpm run lint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{md,css,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "^6.0.1",
      "wrangler": "4.72.0",
      "undici": "7.18.2",
      "lodash": "4.17.23",
      "minimatch": "10.2.1",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "yaml-language-server>ajv": "8.18.0",
      "devalue": "5.6.3"
    }
  },
  "description": "このプロジェクトは、Astroを使用して構築された個人ブログサイトです。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "volta": {
    "node": "22.20.0"
  }
}
