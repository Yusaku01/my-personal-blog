{
  "name": "@example/basics",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm run test:node && pnpm run test:unit",
    "test:node": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.css",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.css --fix",
    "lint:deps": "knip",
    "lint:text": "pnpm run lint:text:blog",
    "lint:text:blog": "node scripts/lint-blog-text.mjs",
    "lint:text:blog:tech": "node scripts/lint-blog-text.mjs --scope tech",
    "lint:text:blog:diary": "node scripts/lint-blog-text.mjs --scope diary",
    "lint:text:ci": "node scripts/lint-blog-text.mjs",
    "perf:measure-fonts": "node scripts/perf/measure-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mermaid:install-browser": "playwright install chromium chromium-headless-shell",
    "generate-ogp": "node scripts/build-ogp.js",
    "build:with-ogp": "pnpm run generate-ogp && pnpm run build",
    "build:cloudflare": "ASTRO_MERMAID_STRATEGY=pre-mermaid pnpm run build:with-ogp",
    "analyze": "ANALYZE=true astro build",
    "db:migrate:local": "wrangler d1 migrations apply CONTACT_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply CONTACT_DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.2.7",
    "budoux": "^0.8.4",
    "cheerio": "^1.2.0",
    "date-fns": "^2.30.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "mermaid": "^11.16.1",
    "open-graph-scraper": "^4.8.1",
    "remark-directive": "^4.0.0",
    "sanitize-filename": "^1.6.4",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/css": "^1.2.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@iconify-json/ic": "^1.2.2",
    "@playwright/browser-chromium": "1.60.0",
    "@types/hast": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@unocss/astro": "66.7.0",
    "@unocss/preset-icons": "^66.7.0",
    "@unocss/preset-typography": "^66.7.0",
    "@unocss/preset-wind3": "^66.7.0",
    "@unocss/reset": "^66.7.0",
    "@unocss/transformer-directives": "^66.7.0",
    "@unocss/transformer-variant-group": "^66.7.0",
    "astro-eslint-parser": "1.4.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-git-hooks": "^2.11.1",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "typescript": "^5.6.0",
    "unified": "^11.0.5",
    "unocss": "^66.7.0",
    "vitest": "^4.1.7",
    "wrangler": "4.112.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run format:check && pnpm run lint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{md,css,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "^6.0.1",
      "lodash": "4.18.1",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "yaml-language-server>ajv": "8.18.0",
      "ajv>fast-uri": "3.1.5",
      "cheerio>undici": "7.29.0",
      "eslint-plugin-astro>postcss": "8.5.23",
      "express-rate-limit>ip-address": "10.3.1",
      "jsdom>undici": "7.29.0",
      "mermaid>dompurify": "3.4.13",
      "miniflare>undici": "7.29.0",
      "postcss>nanoid": "3.3.18",
      "vite>postcss": "8.5.23",
      "picomatch@<2.3.2": "2.3.2",
      "budoux@0.8.4>google-artifactregistry-auth": "-",
      "js-yaml@<3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "@modelcontextprotocol/sdk@1.29.0>@hono/node-server": "-",
      "@modelcontextprotocol/sdk@1.29.0>hono": "4.12.34",
      "miniflare@4.20260714.0>sharp": "0.35.3"
    }
  },
  "description": "このプロジェクトは、Astroを使用して構築された個人ブログサイトです。",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
