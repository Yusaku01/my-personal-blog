    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/zen-kaku-gothic-new": "^5.2.5",
    "@hookform/resolvers": "^3.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "astro": "^5.16.11",
    "budoux": "^0.7.0",
