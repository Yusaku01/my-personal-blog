  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run format:check && pnpm run lint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{md,css,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "^6.0.1",
      "wrangler": "4.59.1",
      "undici": "7.18.2",
      "lodash": "4.17.23"
    },
    "patchedDependencies": {
      "remark-link-card@1.3.1": "patches/remark-link-card@1.3.1.patch"
    }
  },
  "description": "このプロジェクトは、Astroを使用して構築された個人ブログサイトです。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
